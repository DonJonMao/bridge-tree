ttled review of every required original; otherwise leave it pending. Do not\ninvent agreement or call genuine partial/counter evidence irrelevant to close it.\n\n\nReturn one complete JSON object matching this schema:\n{\"additionalProperties\":false,\"properties\":{\"audit_verdict\":{\"enum\":[\"supported\",\"unknown\",\"conflict\"],\"type\":\"string\"},\"final_prediction\":{\"type\":[\"string\",\"null\"]},\"semantic_answer\":{},\"slots\":{\"items\":{\"additionalProperties\":false,\"allOf\":[{\"else\":{\"anyOf\":[{\"properties\":{\"observations\":{\"minItems\":1}}}],\"not\":{\"required\":[\"search_gaps\"]}},\"if\":{\"properties\":{\"reading_status\":{\"const\":\"no_relevant_evidence\"}}},\"then\":{\"properties\":{\"observations\":{\"maxItems\":0},\"unresolved\":{\"maxItems\":0}}}}],\"oneOf\":[{\"properties\":{\"observations\":{\"items\":{\"allOf\":[{\"if\":{\"properties\":{\"stance\":{\"enum\":[\"support\",\"contradiction\"]}}},\"then\":{\"properties\":{\"entity_scope\":{\"const\":\"ICSE duplicate submission statement\"},\"time_scope\":{\"const\":\"agreement\"}}}}],\"else\":{\"properties\":{\"value\":{\"type\":\"null\"}}},\"if\":{\"properties\":{\"stance\":{\"const\":\"support\"}}},\"properties\":{\"retract_ids\":{\"maxItems\":0},\"stance\":{\"enum\":[\"support\",\"partial\",\"unknown\",\"irrelevant\"]}},\"then\":{\"properties\":{\"value\":{\"minLength\":1,\"type\":\"string\"}}}}},\"variable\":{\"const\":\"time\"}}},{\"properties\":{\"observations\":{\"items\":{\"allOf\":[{\"if\":{\"properties\":{\"stance\":{\"enum\":[\"support\",\"contradiction\"]}}},\"then\":{\"properties\":{\"entity_scope\":{\"const\":\"ICSE duplicate submission statement\"},\"time_scope\":{\"const\":\"agreement\"}}}}],\"else\":{\"properties\":{\"value\":{\"type\":\"null\"}}},\"if\":{\"properties\":{\"stance\":{\"const\":\"support\"}}},\"properties\":{\"retract_ids\":{\"maxItems\":0},\"stance\":{\"enum\":[\"support\",\"partial\",\"unknown\",\"irrelevant\"]}},\"then\":{\"properties\":{\"value\":{