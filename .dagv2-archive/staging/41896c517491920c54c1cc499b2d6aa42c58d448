b62e2e5a57e017181c1e7", "tokenization_endpoint_sha256": "0ed12ee94b55bfdbc62fb247243af2d71aa1d7ea503f5f191605ae295c5ad94a", "token_count_is_estimate": false, "token_estimator_id": "deployment_vllm_chat_v1", "tokenizer_id": null, "add_generation_prompt": true, "tokenization_scope": "adapted_plain_text_chat_default_server_template", "token_accounting_note": "Deployment input count; model weights and tokenizer hash are not independently verified", "tokenization_wire_sha256": "50beb6655432c99c2285ea3f97926ee5020c190bbfac26053720352bea25fb59", "sequence": 224, "elapsed_seconds": 67.72426986694336}, {"event": "budget_reserved", "kind": "llm", "stage": "web_grounding_review/11", "amount": 1, "used": 11, "sequence": 225, "elapsed_seconds": 67.72473001480103}, {"event": "budget_reserved", "kind": "http_attempts", "stage": "web_grounding_review/11", "amount": 1, "used": 11, "sequence": 226, "elapsed_seconds": 67.72483325004578}, {"event": "http_response", "stage": "web_grounding_review/11", "response_ref": "bf3438ac9d007e029fc4efb161624301d891faf612eaf235aa8e168dc0d08b76", "kind": "llm", "usage": {"prompt_tokens": 5104, "total_tokens": 5305, "completion_tokens": 201, "prompt_tokens_details": null, "completion_tokens_details": {"reasoning_tokens": 0, "audio_tokens": null, "accepted_prediction_tokens": null, "rejected_prediction_tokens": null}}, "seconds": 7.118475914001465, "sequence": 227, "elapsed_seconds": 74.84531211853027}, {"event": "tokenization_usage_validation", "stage": "web_grounding_review/11", "status": "matched", "expected_prompt_tokens": 5104, "observed_prompt_tokens": 5104, "tokenization_request_sha256": "f25c5ea91ba3e5085805dd19f9b36ff818354a17236b62e2e5a57e017181c1e7", "sequence": 228, "elapsed_seconds": 74.84746098518372}, {"event": "reasoning_response", "operation": "web_grounding_review", "call_index": 11, "messages": [{"role": "system", "content": "\nIndependently check each candidate against the exact offered originals and its\nrequested scope. The candidate is an untrusted proposal, not an established fact.\nReturn entailed, not_entailed or uncertain, with a short reason, for each candidate_id.\nFor support, its cited originals must establish both the requested entity/event/\nrelation and the claimed attribute/value. Another project's attribute, a shared\npartner/site/topic, or the question's presupposition supplies no identity bridge.\nFor partial/unknown, the originals must actually concern that requested scope and\ncontain genuine incomplete evidence; unrelated text is not scoped uncertainty.\nFor irrelevant, check that its cited text warrants irrelevance to the requested\nattribute. For contradiction, check the originals and the offered target claim:\nthe evidence must warrant that specific retraction, not merely a different value.\nSupported parents are grounding inputs only at their supplied scope and versions.\nPrior claims are not certified evidence. No replacement facts, new sources,\nretractions, settlement claims or permission decisions may be returned.\n\n\nReturn one complete JSON object matching this schema:\n{\"additionalProperties\": false, \"properties\": {\"reviews\": {\"items\": {\"additionalProperties\": false, \"properties\": {\"candidate_id\": {\"enum\": [\"984a53f4608cff523c5ae799e2673f03ae9511488c95a5768067e62533535cf3\", \"9a9f8a42fc28ca51b765819b699db4400d32af31f4ff90b97f62d0efb534b347\"], \"type\": \"string\"}, \"reason\": {\"minLength\": 1, \"type\": \"string\"}, \"verdict\": {\"enum\": [\"entailed\", \"not_entailed\", \"uncertain\"], \"type\": \"string\"}}, \"required\": [\"candidate_id\", \"verdict\", \"reason\"], \"type\": \"object\"}, \"maxItems\": 2, \"minItems\": 2, \"type\": \"array\"}}, \"required\": [\"reviews\"], \"type\": \"object\"}"}, {"role": "user", "content": "{\"original_question\": \"When and where was the ICSE duplicate submission statement agreed upon?\", \"requested_scopes\": {\"time\": {\"entity_scope\": \"ICSE duplicate submission statement\", \"time_scope\": \"agreement\"}, \"location\": {\"entity_scope\": \"ICSE duplicate submission statement\", \"time_scope\": \"agreement\"}}, \"supported_parents\": {}, \"source_spans\": [{\"id\": \"s58\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 10033, \"end\": 10354, \"text\": \"After an online discussion about the proposal among the ICSE Steering Committee members, there was a vote and the proposal was approved in March 2018 (16 votes for and 6 votes against).  2.c Selection of the PB and the PC  One can argue that selection of the PB/PC is the most significant task performed by any PC Chair. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s57\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 9679, \"end\": 10033, \"text\": \"The results were 22 in favour of an online meeting, and 11 in favour of a physical meeting, a two thirds majority. After further discussion with the ICSE 2019 General Chair and ICSE 2020 PC Chairs, we decided to propose a review process based on an online PB+PC meeting (Appendix A). We sent the proposal to the ICSE Steering Committee in February 2018. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s59\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 10354, \"end\": 10679, \"text\": \"Our main goal was to select experienced researchers who have demonstrated excellent performance as reviewers and discussants in prior conferences as PB members, and to select researchers with a strong track record both as researchers and reviewers as PC members. We looked for significant prior PC experience for PB members. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s60\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 10679, \"end\": 10912, \"text\": \"For PC members we looked for recognized expertise as demonstrated by strong publication records in quality venues, while taking into account their seniority and research area (which can lead to variations in publication records).    \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s61\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 10912, \"end\": 11312, \"text\": \"We identified several criteria for selection of the PB/PC: ● Aim for proportional coverage of research areas taking into account the historical number of submissions for each research area (we used the data for distribution of papers to research areas from ICSE 2018)  ● Aim for a good gender balance ● Aim for geographic diversity ● Aim for industry representation ● Include the PC Chairs from ICSE \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s62\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 11312, \"end\": 11483, \"text\": \"2018 and ICSE 2020 in either the PB or PC ● Aim to satisfy the SIGSOFT policy: For recurring events, at least one-third of the program committee membership should change. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s63\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 11483, \"end\": 11805, \"text\": \"Most program committee members should not serve for more than three consecutive terms and in no instance should an individual serve more than four consecutive terms.  We created a spreadsheet containing information about candidates for PB and PC (such as research areas, organization, country, gender, industry/academia). \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s64\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 11805, \"end\": 12094, \"text\": \"We used scripts created by prior ICSE chairs for mining publications in DBLP and prior conference committees to search for overlooked candidates with strong records. We met with the PC chairs of ICSE 2018 and ICSE 2017 to get their input on past performance of PB/PC candidates. Based on \\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s65\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 12094, \"end\": 12484, \"text\": \"all the information we gathered and the guidelines we listed above, we created an invitation list and sent the PB invitations in December 2017 and the PC invitations in January 2018. The ICSE 2019 PB and PC were finalized by February 2018.  Of the 132 invitations that were sent out, 21 were either declined or ignored. For these, we added new names, maintaining the criteria given above.  \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s66\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 12484, \"end\": 12812, \"text\": \"In the final list, the gender balance of the PB was 16F/16M and of the PC was 39F/59M. Statistics on geographic diversity are given in Section 4. Generally, we achieved good geographic diversity, although we could not identify suitable PC/PB members from some countries (most notably India) whilst satisfying other constraints. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s67\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 12812, \"end\": 13060, \"text\": \"It is also instructive to compare the ratio of submitting authors to PB/PC members across countries: such an analysis reveals stark disparities. For example, the ratio for the USA is 11:1 but for China is 108:1. More is said on this in Section 4.  \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s68\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 13060, \"end\": 13437, \"text\": \"2.d Timeline and the Review Process  In order to meet the PB and PC members, prepare them for the review process, and receive their feedback about the review process, we organized two separate meetings at ICSE 2018, one for the ICSE 2019 PB and one for the ICSE 2019 PC. In these meetings, we went over a set of slides explaining the review process and asked for their input.  \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s69\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 13437, \"end\": 13837, \"text\": \"We used the same review criteria that were used in recent ICSEs: ● Soundness: How well the paper’s contributions are supported by rigorous application of appropriate research methods, ● Significance: The extent to which the paper’s contributions are novel, original, and important, with respect to the existing body of knowledge, ● Verifiability: Whether the paper includes sufficient information to \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s70\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 13837, \"end\": 14224, \"text\": \"support independent verification or replication of the paper’s claimed contributions, ● Presentation: Whether the paper’s quality of writing meets the high standards of ICSE, including clear descriptions and explanations, adequate use of the English language, absence of major ambiguity, clearly readable figures and tables, and adherence to the formatting instructions provided below.  \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s71\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 14224, \"end\": 14496, \"text\": \"Although the above criteria were listed in the review form, reviewers were not asked to score papers separately on Significance, Soundness, Novelty, Replicability and Presentation Quality. It was considered that these questions did not add value to the decision-making.   \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s72\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 14496, \"end\": 14874, \"text\": \"Another change in the review form compared to prior years was the addition of a question where reviewers were asked to rank their set of papers - for each paper, to say whether the paper was in the Top 15%, Top 16-30%, Top 31-50%, Bottom 50% of the ICSE submissions. Since no reviewer read all submissions, reviewers were asked to use their batch of submissions as a guideline. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s73\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 14874, \"end\": 15027, \"text\": \"The rationale in adding this question was to get reviewers to self-reflect on any biases in their scoring and help them normalize their recommendations. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s74\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 15027, \"end\": 15296, \"text\": \"For example, a reviewer marking a paper as top 15% but giving a strong reject might reconsider their decision and change either their ranking or the recommendation, or might provide an explanation of why those particular scores make sense during the discussion phase.  \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s75\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 15296, \"end\": 15534, \"text\": \"Although we did not empirically evaluate the effects of this new question, in at least one instance the incongruence between the ranking and the score given by a reviewer was discussed and this had an influence on the decision making.   \\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s76\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 15534, \"end\": 15934, \"text\": \" The review process was based on the following principles:  After the desk rejects: ● All papers received 3 reviews written by PC members ○ More reviewers could be assigned if the expertise among the current reviewers was low ● All papers got a chance at a rebuttal of ALL the reviews ○ This implies that no reviews were conducted after the rebuttal period, or equivalently, all reviews had to be sub\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s77\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 15934, \"end\": 15970, \"text\": \"mitted before the rebuttal period.  \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s78\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 15970, \"end\": 16370, \"text\": \"● All papers received a meta-review, written by the PB members, summarizing the discussion, the reaction to the rebuttal and the decision  ● PB members did not re-review the papers but participated in discussions either as a moderator (discussion lead) or as an additional discussant  After the initial check for violations of submission instructions (which can lead to desk rejection) we carried out\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s79\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 16370, \"end\": 16770, \"text\": \" a three phase decision making process: ● Phase 1: After rebuttal, papers with unanimous negative or positive scores were marked as accept or reject as early as possible (we had expected ~60% of papers to be decided this way)  ● Phase 2: Papers with mixed scores were discussed further to reach a consensus decision by the reviewers, under the guidance of the PB member (we had expected ~25-30% of pa\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s80\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 16770, \"end\": 17060, \"text\": \"pers to be decided this way) ● Phase 3: Papers for which reviewers were unable to reach a consensus were discussed during the two-day online PB/PC meeting (we had expected ~10-15% of papers to be decided this way)  A high level overview of the review process is shown in the figure below: \\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s81\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 17060, \"end\": 17443, \"text\": \" \\n\\nThe actual numbers for different phases of the review process were as follows: ● 529 submissions were received. ● 25 (5%) papers were desk rejected either due to double blind rule violation or due to exceeding the page limit (we applied the page limit strictly; any paper that had technical content beyond page 10 was rejected even if it was a single line beyond the page limit). \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s82\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 17443, \"end\": 17823, \"text\": \"● 10 (2%) papers were withdrawn by the authors at various stages of the review process.  ● All remaining 494 papers received at least 3 reviews and one meta-review.   ○ 302 (57%) consensus papers were decided in Phase 1  ○ 192 papers received mixed scores and were discussed in Phase 2. For 127 of these papers (24%) PB and PC members reached a consensus decision before Phase 3. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s83\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 17823, \"end\": 18172, \"text\": \"○ The remaining 65 papers (12%) were discussed in Phase 3. All decisions were finalized by the end of the two-day online PC meeting.  ● 109 (21%) papers were accepted.   It is interesting to note that our predictions about how many papers would be decided in each phase (which we made based on the data from prior years) were reasonably accurate.   \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s84\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 18172, \"end\": 18514, \"text\": \"We started the online discussions as soon as the reviews were received, although we asked reviewers not to make decisions before the rebuttal period (this differs from 2018 when reviewers were asked - but not mandated - to wait for the author responses). After Phase 2, we assigned two more PB members to each undecided paper as discussants. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s85\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 18514, \"end\": 18864, \"text\": \"Discussant PB members were required to read the papers, all the reviews and the discussions. The role of the discussant was to add an additional perspective on a paper to aid decision-making and to take a view on unresolved issues in the reviews.  During the online meeting (Phase 3) the goal was to reach a decision within the 2 days on all papers. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s86\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 18864, \"end\": 19251, \"text\": \"During the online meeting discussion, each paper had at least the following participants: 3 (or more) PC reviewers, a PB discussion leader, and 2 PB discussants. Moreover, the discussions were open to any other PB/PC member with no conflict-of-interest. We empowered the PB members to finalize the decision in cases where reviewers and discussants were unable to converge to a decision. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s87\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 19251, \"end\": 19540, \"text\": \"In practice, consensus was always reached. The PB/PC were instructed that PC Chairs would make an executive decision if a paper remained unresolved at the end of the two-day period. This was not necessary for any papers.  During the online meeting we used Easychair for online discussion. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s88\", \"doc_id\": \"web-f2480c9be1232e0ef2ee3058\", \"start\": 19540, \"end\": 19936, \"text\": \"We occasionally sent emails to the entire PB and PC to answer common questions that came up during discussions. The key issue during the online meeting was to make sure that the PB and PC members were responsive and the discussions were progressing. PC chairs monitored all the ongoing discussions to make sure that progress was being made. We did not use synchronous conversations (skype etc.). \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}], \"retraction_targets\": [], \"candidates\": [{\"candidate_id\": \"984a53f4608cff523c5ae799e2673f03ae9511488c95a5768067e62533535cf3\", \"observation\": {\"id\": \"time_obs_1\", \"stance\": \"support\", \"value\": \"March 2018\", \"source_ids\": [\"s58\"], \"entity_scope\": \"ICSE duplicate submission statement\", \"time_scope\": \"agreement\", \"parent_versions\": {}, \"retract_ids\": [], \"variable\": \"time\"}}, {\"candidate_id\": \"9a9f8a42fc28ca51b765819b699db4400d32af31f4ff90b97f62d0efb534b347\", \"observation\": {\"id\": \"location_obs_1\", \"stance\": \"support\", \"value\": \"online\", \"source_ids\": [\"s58\"], \"entity_scope\": \"ICSE duplicate submission statement\", \"time_scope\": \"agreement\", \"parent_versions\": {}, \"retract_ids\": [], \"variable\": \"location\"}}]}"}], "logical_call_index": 11, "response_format": "plain", "input_tokens_local": 5104, "output_token_reserve": 1024, "input_margin": 256, "max_model_len": 120000, "tokenization_request_sha256": "f25c5ea91ba3e5085805dd19f9b36ff818354a17236b62e2e5a57e017181c1e7", "tokenization_endpoint_sha256": "0ed12ee94b55bfdbc62fb247243af2d71aa1d7ea503f5f19