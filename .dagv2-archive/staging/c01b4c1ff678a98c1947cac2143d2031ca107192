n object before\nreading. References to source_spans[].id or other fields mean those objects.\nThe id column holds source aliases (sN); doc_id holds the original document ID or,\nwhen source_documents is present, its metadata reference (dN), never source_ids.\n\n\nReturn one complete JSON object matching this schema:\n{\"additionalProperties\":false,\"properties\":{\"audit_verdict\":{\"enum\":[\"supported\",\"unknown\",\"conflict\"],\"type\":\"string\"},\"final_prediction\":{\"type\":[\"string\",\"null\"]},\"semantic_answer\":{},\"slots\":{\"items\":{\"additionalProperties\":false,\"oneOf\":[{\"properties\":{\"observations\":{\"items\":{\"else\":{\"properties\":{\"value\":{\"type\":\"null\"}}},\"if\":{\"properties\":{\"stance\":{\"const\":\"support\"}}},\"properties\":{\"retract_ids\":{\"items\":{\"enum\":[\"fact_bcf0acae9e8d7d88ff4f5109\"]}}},\"then\":{\"properties\":{\"value\":{\"type\":\"object\"}}}}},\"variable\":{\"const\":\"preferences\"}}}],\"properties\":{\"observations\":{\"items\":{\"additionalProperties\":false,\"allOf\":[{\"else\":{\"properties\":{\"retract_ids\":{\"maxItems\":0}}},\"if\":{\"properties\":{\"stance\":{\"const\":\"contradiction\"}}},\"then\":{\"properties\":{\"retract_ids\":{\"minItems\":1}}}}],\"properties\":{\"entity_scope\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"parent_versions\":{\"additionalProperties\":{\"type\":\"integer\"},\"type\":\"object\"},\"reason\":{\"type\":\"string\"},\"retract_ids\":{\"items\":{\"type\":\"string\"},\"type\":\"array\",\"uniqueItems\":true},\"source_ids\":{\"description\":\"Exact visible source_spans[].id aliases, such as s3; never document IDs or invented IDs.\",\"items\":{\"type\":\"string\"},\"type\":\"array\",\"uniqueItems\":true},\"stance\":{\"enum\":[\"support\",\"contradiction\",\"partial\",\"unknown\",\"irrelevant\"],\"type\":\"string\"},\"time_scope\":{\"type\":\"string\"},\"value\":{}},\"required\":[\"id\",\"stance\",\"value\",\"source_ids\",\"entity_scope\",\"time_scope\",\"parent_ve