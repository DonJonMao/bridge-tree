\": [\"author\", \"detective\"]}, {\"unit_id\": \"u13\", \"source_span_id\": \"s13\", \"doc_id\": \"hotpotqa:2203\", \"node_ids\": [\"author\", \"detective\"]}, {\"unit_id\": \"u14\", \"source_span_id\": \"s14\", \"doc_id\": \"hotpotqa:2203\", \"node_ids\": [\"author\", \"detective\"]}, {\"unit_id\": \"u15\", \"source_span_id\": \"s15\", \"doc_id\": \"hotpotqa:17\", \"node_ids\": [\"author\", \"detective\"]}, {\"unit_id\": \"u16\", \"source_span_id\": \"s16\", \"doc_id\": \"hotpotqa:6159\", \"node_ids\": [\"author\", \"detective\"]}, {\"unit_id\": \"u17\", \"source_span_id\": \"s17\", \"doc_id\": \"hotpotqa:6159\", \"node_ids\": [\"author\", \"detective\"]}, {\"unit_id\": \"u18\", \"source_span_id\": \"s18\", \"doc_id\": \"hotpotqa:11\", \"node_ids\": [\"author\", \"detective\"]}, {\"unit_id\": \"u19\", \"source_span_id\": \"s19\", \"doc_id\": \"hotpotqa:4843\", \"node_ids\": [\"author\", \"detective\"]}, {\"unit_id\": \"u20\", \"source_span_id\": \"s20\", \"doc_id\": \"hotpotqa:7676\", \"node_ids\": [\"author\", \"detective\"]}, {\"unit_id\": \"u21\", \"source_span_id\": \"s21\", \"doc_id\": \"hotpotqa:7676\", \"node_ids\": [\"author\", \"detective\"]}, {\"unit_id\": \"u22\", \"source_span_id\": \"s22\", \"doc_id\": \"hotpotqa:4848\", \"node_ids\": [\"author\", \"detective\"]}, {\"unit_id\": \"u23\", \"source_span_id\": \"s23\", \"doc_id\": \"hotpotqa:4848\", \"node_ids\": [\"author\", \"detective\"]}, {\"unit_id\": \"u24\", \"source_span_id\": \"s24\", \"doc_id\": \"hotpotqa:4849\", \"node_ids\": [\"author\", \"detective\"]}], \"source_spans\": [{\"id\": \"s1\", \"doc_id\": \"hotpotqa:13\", \"start\": 0, \"end\": 224, \"text\": \"The Adventure of the Seven Clocks\\n\\\"The Adventure of the Seven Clocks\\\" is a Sherlock Holmes story by Adrian Conan Doyle and John Dickson Carr. The story was published in the 1954 collection, \\\"The Exploits of Sherlock Holmes\\\".\", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s2\", \"doc_id\": \"hotpotqa:18\", \"start\": 0, \"end\": 391, \"text\": \"Sherlock Holmes\\nSherlock Holmes ( ) is a fictional private detective created by British author Sir Arthur Conan Doyle. Known as a \\\"consulting detective\\\" in the stories, Holmes is known for his proficiency with observation, forensic science, and logical reasoning that borders on the fantastic, which he employs when investigating cases for a wide variety of clients, including Scotland Yard.\", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s3\", \"doc_id\": \"hotpotqa:15\", \"start\": 0, \"end\": 379, \"text\": \"Nick Carter, Master Detective\\nNick Carter, Master Detective was a Mutual radio crime drama based on tales of the fictional private detective Nick Carter from Street & Smith's dime novels and pulp magazines. Nick Carter first came to radio as The Return of Nick Carter, a reference to the character's pulp origins, but the title was soon changed to Nick Carter, Master Detective. \", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s4\", \"doc_id\": \"hotpotqa:15\", \"start\": 379, \"end\": 447, \"text\": \"A veteran radio dramatist, Ferrin Fraser, wrote many of the scripts.\", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s5\", \"doc_id\": \"hotpotqa:4844\", \"start\": 0, \"end\": 360, \"text\": \"Agatha Christie\\nDame Agatha Mary Clarissa Christie, Lady Mallowan, DBE (\\\"née\\\" Miller; 15 September 1890 – 12 January 1976) was an English crime novelist, short story writer and playwright. She is best known for her 66 detective novels and 14 short story collections, particularly those revolving around her fictional detectives Hercule Poirot and Miss Marple. \", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s6\", \"doc_id\": \"hotpotqa:4844\", \"start\": 360, \"end\": 612, \"text\": \"She also wrote the world's longest-running play, a murder mystery, \\\"The Mousetrap\\\", and six romances under the name Mary Westmacott. In 1971 she was elevated to Dame Commander of the Order of the British Empire (DBE) for her contribution to literature.\", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s7\", \"doc_id\": \"hotpotqa:16\", \"start\": 0, \"end\": 388, \"text\": \"Dan Turner, Hollywood Detective\\nDan Turner, also known as the Hollywood Detective, was a fictional private detective created by Robert Leslie Bellem. His first appearance was in the second issue of the pulp magazine \\\"Spicy Detective\\\", dated June 1934, and he continued to appear regularly in that magazine (which was retitled \\\"Speed Detective\\\" in 1943) until its demise in February 1947. \", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s8\", \"doc_id\": \"hotpotqa:16\", \"start\": 388, \"end\": 563, \"text\": \"He also appeared in his \\\"own\\\" magazine, \\\"Hollywood Detective\\\", which was published by Culture Publications (later Trojan Publishing) and ran from January 1942 to October 1950.\", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s9\", \"doc_id\": \"hotpotqa:2607\", \"start\": 0, \"end\": 248, \"text\": \"He Who Whispers\\nHe Who Whispers is a mystery novel (1946) by detective novelist John Dickson Carr. Like Many of the works by this author feature so-called impossible crimes (for the most part, falling into the category of the locked room mystery). \", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s10\", \"doc_id\": \"hotpotqa:2607\", \"start\": 248, \"end\": 577, \"text\": \"In this case, the novel falls into a smaller category of Carr's work in that it is suggested that the crime is the work of a supernatural being (here, a vampire). The detective is Dr. Gideon Fell, who ultimately uncovers a rational explanation for the novel's events. Carr considered this one of his best impossible crime novels.\", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s11\", \"doc_id\": \"hotpotqa:12\", \"start\": 0, \"end\": 166, \"text\": \"Michael Shayne\\nMichael \\\"Mike\\\" Shayne is a fictional private detective character created during the late 1930s by writer Brett Halliday, a pseudonym of Davis Dresser. \", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s12\", \"doc_id\": \"hotpotqa:12\", \"start\": 166, \"end\": 515, \"text\": \"The character appeared in a series of seven films starring Lloyd Nolan for Twentieth Century Fox, five films from the low-budget Producers Releasing Corporation with Hugh Beaumont, a radio series under a variety of titles between 1944 and 1953, and later in 1960–1961 in a 32-episode NBC television series starring Richard Denning in the title role.\", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s13\", \"doc_id\": \"hotpotqa:2203\", \"start\": 0, \"end\": 366, \"text\": \"The Return of Sherlock Holmes (1929 film)\\nThe Return of Sherlock Holmes is a 1929 American Pre-Code mystery film directed by Basil Dean and written by Arthur Conan Doyle, Basil Dean and Garrett Fort. The film shares its title with the third volume of the Sherlock Holmes stories, \\\"The Return of Sherlock Holmes\\\" by Arthur Conan Doyle. The film stars Clive Brook, H. \", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s14\", \"doc_id\": \"hotpotqa:2203\", \"start\": 366, \"end\": 533, \"text\": \"Reeves-Smith, Betty Lawford, Charles Hay and Phillips Holmes. The film was released October 29, 1929, by Paramount Pictures. A copy is held at the Library of Congress.\", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s15\", \"doc_id\": \"hotpotqa:17\", \"start\": 0, \"end\": 136, \"text\": \"Pepe Carvalho\\nPepe Carvalho is a fictional private detective, the protagonist of a series of novels written by Manuel Vázquez Montalbán.\", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s16\", \"doc_id\": \"hotpotqa:6159\", \"start\": 0, \"end\": 339, \"text\": \"Seven Footprints to Satan\\nSeven Footprints to Satan is a 1929 American horror film directed by Danish filmmaker Benjamin Christensen. Based on the book of the same name by Abraham Merritt, it stars Thelma Todd, Creighton Hale, William V. Mong and Sheldon Lewis, and contains appearances by Sōjin Kamiyama and Angelo Rossitto among others. \", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s17\", \"doc_id\": \"hotpotqa:6159\", \"start\": 339, \"end\": 467, \"text\": \"It was produced as both a silent film and as a part-talkie, making it one of the last – if not \\\"the\\\" last – silent horror films.\", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s18\", \"doc_id\": \"hotpotqa:11\", \"start\": 0, \"end\": 137, \"text\": \"Hazell (TV series)\\nHazell is a British television series that ran from 1978–1979, about a fictional private detective named James Hazell.\", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s19\", \"doc_id\": \"hotpotqa:4843\", \"start\": 0, \"end\": 253, \"text\": \"Agatha Christie (video game series)\\nThe \\\"Agatha Christie\\\" series is a series of adventure games developed by AWE Games and published by The Adventure Company and DreamCatcher Interactive, based on the works of the English mystery writer Agatha Christie.\", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s20\", \"doc_id\": \"hotpotqa:7676\", \"start\": 0, \"end\": 335, \"text\": \"Mr. Holmes\\nMr. Holmes is a 2015 British–American crime drama mystery film, directed by Bill Condon, based on Mitch Cullin's 2005 novel \\\"A Slight Trick of the Mind\\\", and featuring the character Sherlock Holmes. The film stars Ian McKellen as Sherlock Holmes, Laura Linney as his housekeeper Mrs. Munro and Milo Parker as her son Roger. \", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s21\", \"doc_id\": \"hotpotqa:7676\", \"start\": 335, \"end\": 505, \"text\": \"Set primarily during his retirement, the film follows a 93-year-old Holmes who struggles to recall the details of his final case because his mind is slowly deteriorating.\", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s22\", \"doc_id\": \"hotpotqa:4848\", \"start\": 0, \"end\": 308, \"text\": \"Agatha Christie Memorial\\nThe Agatha Christie Memorial is a memorial to author and playwright Agatha Christie, located at the intersection of Cranbourn Street and Great Newport Street by St Martin's Cross near Covent Garden, in London, United Kingdom. It is located in the heart of London's theatre district. \", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s23\", \"doc_id\": \"hotpotqa:4848\", \"start\": 308, \"end\": 556, \"text\": \"This was chosen to pay homage to Christie's contribution to theatre: her murder mystery play \\\"The Mousetrap\\\" is the world's longest-running show, and she was the first female playwright to have three plays performing simultaneously in the West End.\", \"source_role\": \"document\", \"source_message_indices\": []}, {\"id\": \"s24\", \"doc_id\": \"hotpotqa:4849\", \"start\": 0, \"end\": 365, \"text\": \"Agatha Christie: Evil Under the Sun\\nAgatha Christie: Evil Under the Sun is a video game released for the PC and Nintendo Wii, and is the third installment of The Adventure Company's \\\"Agatha Christie\\\" series, developed by AWE Productions, based on Agatha Christie's novel \\\"Evil Under the Sun\\\". The PC version was released in 2007, and the Wii version one year later.\", \"source_role\": \"document\", \"source_message_indices\": []}]}"}], "logical_call_index": 2, "response_format": "plain", "input_tokens_local": 6049, "output_token_reserve": 4096, "input_margin": 256, "token_count_is_estimate": true, "token_estimator_id": "regex_or_utf8_bytes_div3_v2", "tokenizer_id": null, "token_acco