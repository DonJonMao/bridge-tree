ables\ncannot use summary_revision. If a complete compatible account is not supported,\nreturn sourced partial/unresolved instead. Multiple new supports must agree on\none whole value. Existing superseded_by links identify retired representations;\ntheir original evidence remains available. revoked holds actual counterevidence,\nwhich is never erased by a summary revision or ignored through its ancestry.\n\n\nReturn one complete JSON object matching this schema:\n{\"additionalProperties\":false,\"properties\":{\"slots\":{\"items\":{\"additionalProperties\":false,\"oneOf\":[{\"properties\":{\"observations\":{\"items\":{\"allOf\":[{\"if\":{\"properties\":{\"stance\":{\"enum\":[\"support\",\"contradiction\"]}}},\"then\":{\"properties\":{\"entity_scope\":{\"const\":\"user\"},\"time_scope\":{\"const\":\"past\"}}}}],\"else\":{\"properties\":{\"value\":{\"type\":\"null\"}}},\"if\":{\"properties\":{\"stance\":{\"const\":\"support\"}}},\"properties\":{\"retract_ids\":{\"maxItems\":0},\"stance\":{\"enum\":[\"support\",\"partial\",\"unknown\",\"irrelevant\"]}},\"then\":{\"properties\":{\"value\":{\"minLength\":1,\"type\":\"string\"}}}}},\"variable\":{\"const\":\"podcast_history\"}}}],\"properties\":{\"observations\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"entity_scope\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"parent_versions\":{\"additionalProperties\":{\"type\":\"integer\"},\"type\":\"object\"},\"reason\":{\"type\":\"string\"},\"retract_ids\":{\"items\":{\"type\":\"string\"},\"type\":\"array\",\"uniqueItems\":true},\"source_ids\":{\"description\":\"Exact visible source_spans[].id aliases, such as s3; never document IDs or invented IDs.\",\"items\":{\"type\":\"string\"},\"type\":\"array\",\"uniqueItems\":true},\"stance\":{\"enum\":[\"support\",\"contradiction\",\"partial\",\"unknown\",\"irrelevant\"],\"type\":\"string\"},\"time_scope\":{\"type\":\"string\"},\"value\":{}},\"required\":[\"id\",\"stance\",\"value\",\"source_ids\",\"entity_scope\"