[[\"s427\",\"d1\",0,370,\"ICSE EDI\\nICSE EDI\\nICSE\\nInternational Conference\\non Software Engineering®\\nHOME\\nNews from the SC\\nEDI STATEMENT\\nCONDUCT & SAFETY\\nHISTORY\\nPROCEEDINGS\\nINFLUENTIAL PAPERS\\nORGANIZING ICSE\\nSTEERING COMMITTEE\\nICSE SC Documents\\nSPONSORS\\nCONTACTS\\nLast updated\\nJan 2026\\nIEEE COMPUTER SOCIETY EDI STATEMENTS\\nConferences EDI Statement:\\nIEEE Computer Society Open Conference Statement\\n\",\"document\",[]],[\"s428\",\"d1\",370,760,\"Equity, Diversity, and Inclusion are central to the goals of the IEEE Computer Society and\\nall of its conferences. Equity at\\nits heart is about removing barriers, biases, and obstacles that impede equal access and\\nopportunity to succeed.\\nDiversity is fundamentally about valuing human differences and recognizing diverse talents.\\nInclusion is the active\\nengagement of Diversity and Equity.\\n\",\"document\",[]],[\"s429\",\"d1\",760,1125,\"A goal of the IEEE Computer Society is to foster an environment in which all individuals are\\nentitled to participate in any\\nIEEE Computer Society activity free of discrimination. For this reason, the IEEE Computer\\nSociety is firmly committed to\\nteam compositions in all sponsored activities, including but not limited to, technical\\ncommittees, steering committees,\\n\",\"document\",[]],[\"s430\",\"d1\",1125,1477,\"conference organizations, standards committees, and ad hoc committees that display Equity,\\nDiversity, and Inclusion.\\nIEEE Computer Society meetings, conferences and workshops must provide a welcoming, open and\\nsafe environment,\\nthat embraces the value of every person, regardless of race, color, sex, sexual orientation,\\ngender identity or expression,\\n\",\"document\",[]],[\"s431\",\"d1\",1477,1818,\"age, marital status, religion, national origin, ancestry, or disability. All individuals are\\nentitled to participate in any IEEE\\nComputer Society activity free of discrimination, including harassment based on any of the\\nabove factors.\\nTechnical Committee EDI Statement:\\nIEEE Computer Society Equity, Diversity, and Inclusion (EDI) Statement\\n\",\"document\",[]],[\"s432\",\"d1\",1818,2213,\"Equity, Diversity, and Inclusion (EDI) are central to the goals of the IEEE Computer Society and\\nall of its activities. Equity\\nat its heart is about removing barriers, biases, and obstacles that impede equal access and\\nopportunity to succeed.\\nDiversity is fundamentally about valuing human differences and recognizing diverse talents.\\nInclusion is the active\\nengagement of Diversity and Equity.\\n\",\"document\",[]],[\"s433\",\"d1\",2213,2578,\"A goal of the IEEE Computer Society is to foster an environment in which all individuals are\\nentitled to participate in any\\nIEEE Computer Society activity free of discrimination. For this reason, the IEEE Computer\\nSociety is firmly committed to\\nteam compositions in all sponsored activities, including but not limited to, technical\\ncommittees, steering committees,\\n\",\"document\",[]],[\"s434\",\"d1\",2578,2940,\"conference organizations, standards committees, and ad hoc committees that display Equity,\\nDiversity, and Inclusion.\\nIEEE Computer Society EDI Website\\nACM OPEN CONFERENCES STATEMENT\\nThe open exchange of ideas and the freedom of thought and expression are central to the aims\\nand goals of ACM and its conferences. These aims and goals require an environment that\\n\",\"document\",[]],[\"s435\",\"d1\",2940,3328,\"recognizes the inherent worth of every person and group, that fosters dignity,\\nunderstanding, and mutual respect, and that embraces diversity.\\nACM is firmly committed to prohibiting discrimination at its conferences against individuals\\nbecause of race, color, sex, sexual orientation, gender identity or expression, age, marital\\nstatus religion, national origin, ancestry, or disability. \",\"document\",[]],[\"s436\",\"d1\",3328,3653,\"All individuals are entitled to\\nparticipate in any ACM activity free of discrimination, including harassment based on any of\\nthe above factors.\\nACM is concerned about discriminatory legislation in various locations and will work with\\nconference organizers to best address location related issues.\\nACM Open Conferences Website\",\"document\",[]]],\"required_scope\":{\"entity_scope\":\"ICSE duplicate submission statement\",\"time_scope\":\"agreement\"},\"rules_completion_required\":false,\"supported_task_outputs\":{},\"source_documents\":{\"d1\":{\"doc_id\":\"web-257dbfabc5e7555fce8d66c6\",\"time_metadata\":{}}},\"source_span_columns\":[\"id\",\"doc_id\",\"start\",\"end\",\"text\",\"source_role\",\"source_message_indices\"]}"}], "logical_call_index": 19, "response_format": "plain", "input_tokens_local": 5172, "output_token_reserve": 4096, "input_margin": 256, "max_model_len": 120000, "tokenization_request_sha256": "32615c8349bf816debb3511a2dee2b63cf315e06d38e99f9832d169d9019ce60", "tokenization_endpoint_sha256": "0ed12ee94b55bfdbc62fb247243af2d71aa1d7ea503f5f191605ae295c5ad94a", "token_count_is_estimate": false, "token_estimator_id": "deployment_vllm_chat_v1", "tokenizer_id": null, "add_generation_prompt": true, "tokenization_scope": "adapted_plain_text_chat_default_server_template", "token_accounting_note": "Deployment input count; model weights and tokenizer hash are not independently verified", "tokenization_wire_sha256": "83eb40a9346bc2d420b723abab361aa5dc340da689b023b142b3ed17a8d50c4e", "raw_output": "{\n  \"slots\": [\n    {\n      \"variable\": \"date\",\n      \"observations\": [],\n      \"unresolved\": [],\n      \"reading_status\": \"no_relevant_evidence\"\n    }\n  ]\n}", "response_metadata": {"finish_reason": "stop", "refusal": null, "usage": {"prompt_tokens": 5172, "total_tokens": 5219, "completion_tokens": 47, "prompt_tokens_details": null, "completion_tokens_details": {"reasoning_tokens": 0, "audio_tokens": null, "accepted_prediction_tokens": null, "rejected_prediction_tokens": null}}, "response_id": "chatcmpl-