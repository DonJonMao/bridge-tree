   todo_sessions = [(i, s) for i, s in todo_sessions if i not in data]\n+    for i, entry in tqdm(todo_sessions):\n+        expansion = generate_session_keyphrases(entry, model_name)\n+        data[i] = expansion\n+        print({i: expansion})\n+        \n+    json.dump(data, open(cache_file, 'w'))"},{"sha":"10edc5fb348d5730dbea8656a22f92ae1af78b75","filename":"RF_mem/LongMemEval/src/index_expansion/batch_expansion_session_summ.py","status":"added","additions":78,"deletions":0,"changes":78,"blob_url":"https://github.com/Applied-Machine-Learning-Lab/ICLR2026_RF-Mem/blob/d6a2cb3416e8320bcb1439921d319729aeccec8e/RF_mem%2FLongMemEval%2Fsrc%2Findex_expansion%2Fbatch_expansion_session_summ.py","raw_url":"https://github.com/Applied-Machine-Learning-Lab/ICLR2026_RF-Mem/raw/d6a2cb3416e8320bcb1439921d319729aeccec8e/RF_mem%2FLongMemEval%2Fsrc%2Findex_expansion%2Fbatch_expansion_session_summ.py","contents_url":"https://api.github.com/repos/Applied-Machine-Learning-Lab/ICLR2026_RF-Mem/contents/RF_mem%2FLongMemEval%2Fsrc%2Findex_expansion%2Fbatch_expansion_session_summ.py?ref=d6a2cb3416e8320bcb1439921d319729aeccec8e","patch":"@@ -0,0 +1,78 @@\n+import os\n+import json\n+from tqdm import tqdm\n+from openai import OpenAI\n+import openai\n+import backoff\n+\n+@backoff.on_exception(backoff.constant, (openai.RateLimitError), \n+                      interval=5)\n+def chat_completions_with_backoff(client, **kwargs):\n+    return client.chat.completions.create(**kwargs)\n+\n+\n+client = OpenAI(\n+    api_key=\"empty\",\n+    base_url=\"http://localhost:8001/v1\",\n+)\n+\n+\n+def summarize_session(sess_entry, model_name):\n+    # memorybank prompt\n+    # summarization_prompt = \"Below is a transcript of a conversation between a human user and an AI assistant. Please summarize the following dialogue as concisely as possible, extracting the main themes and key information. If there are multiple key events, you may summarize them separately. Dialogue content:\\n\"\n+    summarization_prom