ue. Existing superseded_by links identify retired representations;\ntheir original evidence remains available. revoked holds actual counterevidence,\nwhich is never erased by a summary revision or ignored through its ancestry.\n\n\nReturn one complete JSON object matching this schema:\n{\"additionalProperties\":false,\"properties\":{\"slots\":{\"items\":{\"additionalProperties\":false,\"allOf\":[{\"if\":{\"properties\":{\"resolved_obligation_ids\":{\"minItems\":1}},\"required\":[\"resolved_obligation_ids\"]},\"then\":{\"properties\":{\"unresolved\":{\"maxItems\":0}}}}],\"oneOf\":[{\"properties\":{\"observations\":{\"items\":{\"allOf\":[{\"if\":{\"properties\":{\"stance\":{\"enum\":[\"support\",\"contradiction\"]}}},\"then\":{\"properties\":{\"entity_scope\":{\"const\":\"user\"},\"time_scope\":{\"const\":\"current\"}}}}],\"else\":{\"properties\":{\"value\":{\"type\":\"null\"}}},\"if\":{\"properties\":{\"stance\":{\"const\":\"support\"}}},\"properties\":{\"retract_ids\":{\"maxItems\":0},\"stance\":{\"enum\":[\"support\",\"partial\",\"unknown\",\"irrelevant\"]}},\"then\":{\"properties\":{\"value\":{\"minLength\":1,\"type\":\"string\"}}}}},\"resolved_failed_batch_ids\":{\"items\":{\"enum\":[\"failed_batch_c5317f05dbfcc1056456de40\"]}},\"resolved_obligation_ids\":{\"items\":{\"enum\":[\"obligation_61a01438e07836ed9c2e376c\"]}},\"variable\":{\"const\":\"current_constraints\"}}}],\"properties\":{\"observations\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"entity_scope\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"parent_versions\":{\"additionalProperties\":{\"type\":\"integer\"},\"type\":\"object\"},\"reason\":{\"type\":\"string\"},\"retract_ids\":{\"items\":{\"type\":\"string\"},\"type\":\"array\",\"uniqueItems\":true},\"source_ids\":{\"description\":\"Exact visible source_spans[].id aliases, such as s3; never document IDs or invented IDs.\",\"items\":{\"type\":\"string\"},\"type\":\"array\",\"uniqueItems\":true},\"stance\":{\"enum\":[\"support\"