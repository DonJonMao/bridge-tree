\text{Recollection},&amp;\bar{s}\leq\theta_{\text{low}},\\[6.0pt]
\begin{cases}\text{Familiarity},&amp;H(p)\leq\tau,\\
\text{Recollection},&amp;H(p)&gt;\tau,\end{cases}&amp;\theta_{\text{low}}&lt;\bar{s}&lt;\theta_{\text{high}}.\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><mtext>Strategy</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>Familiarity</mtext><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mover accent="true"><mi>s</mi><mo>¯</mo></mover><mo>≥</mo><msub><mi>θ</mi><mtext>high</mtext></msub></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>Recollection</mtext><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mover accent="true"><mi>s</mi><mo>¯</mo></mover><mo>≤</mo><msub><mi>θ</mi><mtext>low</mtext></msub></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>Familiarity</mtext><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>τ</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>Recollection</mtext><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mi>τ</mi></mrow><mo>,</mo></mrow></mtd></mtr></mtable></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>θ</mi><mtext>low</mtext></msub><mo>&lt;</mo><mover accent="true"><mi>s</mi><mo>¯</mo></mover><mo>&lt;</mo><msub><mi>θ</mi><mtext>high</mtext></msub></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\text{Strategy}(q)=\begin{cases}\text{Familiarity},&amp;\bar{s}\geq\theta_{\text{high}},\\[6.0pt]
