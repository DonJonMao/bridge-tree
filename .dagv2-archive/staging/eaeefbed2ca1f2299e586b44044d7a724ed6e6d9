\begin{cases}\text{Familiarity},&amp;H(p)\leq\tau,\\
\text{Recollection},&amp;H(p)&gt;\tau,\end{cases}&amp;\theta_{\text{low}}&lt;\bar{s}&lt;\theta_{\text{high}}.\end{cases}</annotation></semantics></math></td>
