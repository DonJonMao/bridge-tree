ables\ncannot use summary_revision. If a complete compatible account is not supported,\nreturn sourced partial/unresolved instead. Multiple new supports must agree on\none whole value. Existing superseded_by links identify retired representations;\ntheir original evidence remains available. revoked holds actual counterevidence,\nwhich is never erased by a summary revision or ignored through its ancestry.\n\n\nReturn one complete JSON object matching this schema:\n{\"additionalProperties\":false,\"properties\":{\"slots\":{\"items\":{\"additionalProperties\":false,\"oneOf\":[{\"properties\":{\"observations\":{\"items\":{\"allOf\":[{\"if\":{\"properties\":{\"stance\":{\"enum\":[\"support\",\"contradiction\"]}}},\"then\":{\"properties\":{\"entity_scope\":{\"const\":\"user\"},\"time_scope\":{\"const\":\"past\"}}}},{\"if\":{\"required\":[\"summary_revision\"]},\"then\":{\"properties\":{\"retract_ids\":{\"maxItems\":0},\"stance\":{\"const\":\"support\"},\"summary_revision\":{\"properties\":{\"previous_version\":{\"const\":2},\"supersedes_route_ids\":{\"items\":{\"enum\":[\"fact_eea96da5ed6aec3e471036e5\"]}}}}}}}],\"else\":{\"properties\":{\"value\":{\"type\":\"null\"}}},\"if\":{\"properties\":{\"stance\":{\"const\":\"support\"}}},\"properties\":{\"retract_ids\":{\"items\":{\"enum\":[\"fact_4003bdfd9aa4fccf10cf65dc\",\"fact_eea96da5ed6aec3e471036e5\"]}}},\"then\":{\"properties\":{\"value\":{\"minLength\":1,\"type\":\"string\"}}}}},\"variable\":{\"const\":\"music_history\"}}}],\"properties\":{\"observations\":{\"items\":{\"additionalProperties\":false,\"allOf\":[{\"else\":{\"properties\":{\"retract_ids\":{\"maxItems\":0}}},\"if\":{\"properties\":{\"stance\":{\"const\":\"contradiction\"}}},\"then\":{\"properties\":{\"retract_ids\":{\"minItems\":1}}}}],\"properties\":{\"entity_scope\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"parent_versions\":{\"additionalProperties\":{\"type\":\"integer\"},\"type\":\"object\"},\"reason\":{\"type\":\"string\"},\"retract_ids\":{\"it