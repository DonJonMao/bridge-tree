 by a summary revision or ignored through its ancestry.\n\n\nReturn one complete JSON object matching this schema:\n{\"additionalProperties\":false,\"properties\":{\"slots\":{\"items\":{\"additionalProperties\":false,\"allOf\":[{\"if\":{\"properties\":{\"resolved_obligation_ids\":{\"minItems\":1}},\"required\":[\"resolved_obligation_ids\"]},\"then\":{\"properties\":{\"unresolved\":{\"maxItems\":0}}}}],\"oneOf\":[{\"properties\":{\"observations\":{\"items\":{\"allOf\":[{\"if\":{\"properties\":{\"stance\":{\"enum\":[\"support\",\"contradiction\"]}}},\"then\":{\"properties\":{\"entity_scope\":{\"const\":\"user\"},\"time_scope\":{\"const\":\"current\"}}}},{\"if\":{\"required\":[\"summary_revision\"]},\"then\":{\"properties\":{\"retract_ids\":{\"maxItems\":0},\"stance\":{\"const\":\"support\"},\"summary_revision\":{\"properties\":{\"previous_version\":{\"const\":1},\"supersedes_route_ids\":{\"items\":{\"enum\":[\"fact_11f4cd2f131060c71992c281\"]}}}}}}}],\"else\":{\"properties\":{\"value\":{\"type\":\"null\"}}},\"if\":{\"properties\":{\"stance\":{\"const\":\"support\"}}},\"properties\":{\"id\":{\"not\":{\"enum\":[\"obs_getaway_revision_1\"]}},\"retract_ids\":{\"items\":{\"enum\":[\"fact_11f4cd2f131060c71992c281\"]}}},\"then\":{\"properties\":{\"value\":{\"minLength\":1,\"type\":\"string\"}}}}},\"resolved_obligation_ids\":{\"items\":{\"enum\":[\"obligation_5edf1094a83fac4bf4752e86\"]}},\"reviewed_observation_ids\":{\"items\":{\"enum\":[\"obs_getaway_revision_1\"]}},\"variable\":{\"const\":\"getaway_constraints\"}}}],\"properties\":{\"observations\":{\"items\":{\"additionalProperties\":false,\"allOf\":[{\"else\":{\"properties\":{\"retract_ids\":{\"maxItems\":0}}},\"if\":{\"properties\":{\"stance\":{\"const\":\"contradiction\"}}},\"then\":{\"properties\":{\"retract_ids\":{\"minItems\":1}}}}],\"properties\":{\"entity_scope\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"parent_versions\":{\"additionalProperties\":{\"type\":\"integer\"},\"type\":\"object\"},\"reason\":{