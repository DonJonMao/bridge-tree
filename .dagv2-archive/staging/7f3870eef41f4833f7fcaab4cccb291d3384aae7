"const\":\"start_date\"}}},{\"properties\":{\"observations\":{\"items\":{\"allOf\":[{\"if\":{\"properties\":{\"stance\":{\"enum\":[\"support\",\"contradiction\"]}}},\"then\":{\"properties\":{\"entity_scope\":{\"const\":\"SUPPLY project involving EHA\"},\"time_scope\":{\"const\":\"project timeline\"}}}}],\"else\":{\"properties\":{\"value\":{\"type\":\"null\"}}},\"if\":{\"properties\":{\"stance\":{\"const\":\"support\"}}},\"properties\":{\"retract_ids\":{\"maxItems\":0},\"stance\":{\"enum\":[\"support\",\"partial\",\"unknown\",\"irrelevant\"]}},\"then\":{\"properties\":{\"value\":{\"minLength\":1,\"type\":\"string\"}}}}},\"resolved_obligation_ids\":{\"items\":{\"enum\":[\"obligation_daeb0e980197711cb4f090bb\"]}},\"variable\":{\"const\":\"duration\"}}}],\"properties\":{\"observations\":{\"items\":{\"additionalProperties\":false,\"allOf\":[{\"else\":{\"properties\":{\"retract_ids\":{\"maxItems\":0}}},\"if\":{\"properties\":{\"stance\":{\"const\":\"contradiction\"}}},\"then\":{\"properties\":{\"retract_ids\":{\"minItems\":1}}}}],\"properties\":{\"entity_scope\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"parent_versions\":{\"additionalProperties\":{\"type\":\"integer\"},\"type\":\"object\"},\"reason\":{\"type\":\"string\"},\"retract_ids\":{\"items\":{\"type\":\"string\"},\"type\":\"array\",\"uniqueItems\":true},\"source_ids\":{\"description\":\"Exact visible source_spans[].id aliases, such as s3; never document IDs or invented IDs.\",\"items\":{\"type\":\"string\"},\"minItems\":1,\"type\":\"array\",\"uniqueItems\":true},\"stance\":{\"enum\":[\"support\",\"contradiction\",\"partial\",\"unknown\",\"irrelevant\"],\"type\":\"string\"},\"time_scope\":{\"type\":\"string\"},\"value\":{}},\"required\":[\"id\",\"stance\",\"value\",\"source_ids\",\"entity_scope\",\"time_scope\",\"parent_versions\",\"retract_ids\",\"reason\"],\"type\":\"object\"},\"type\":\"array\"},\"reading_status\":{\"enum\":[\"no_relevant_evidence\",\"evidence_assessment\"],\"type\":\"string\"},\"resolved_obligation_ids\":{\"items\":{\"type\":\"string\"},\"type\":\"array\",\"uniqueItems\":true},\"search_gaps\":{\"description\":\"Untried search directions only; permitted with empty observations and unresolved.\",\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\"},\"unresolved\":{\"items\":{\"type\":\"string\"},\"maxItems\":0,\"type\":\"array\"},\"variable\":{\"enum\":[\"funding_program\",\"start_date\",\"duration\"],\"type\":\"string\"}},\"required\":[\"variable\",\"observations\",\"unresolved\",\"reading_status\"],\"type\":\"object\"},\"maxItems\":3,\"minItems\":3,\"type\":\"array\"}},\"required\":[\"slots\"],\"type\":\"object\"}"}, {"role": "user", "content": "{\"original_question\":\"Which program funded the SUPPLY project involving EHA, when did the project start, and how long will it last?\",\"task\":{\"question\":\"Which program funded the SUPPLY project involving EHA, when did the project start, and how long will it last?\",\"output_slot\":\"project_info\",\"answer_type\":\"record\",\"inputs\":[],\"execution\":\"retrieval\"},\"grounded_subquestion\":\"Which program funded the SUPPLY project involving EHA, when did the project start, and how long will it last?\",\"request_context\":{\"query_identity\":\"27b5b4b665c793b5860fc3f60d5d72444190dc6a2d856551bdb7a5158946f5d2\",\"algorithm_version\":\"dagbt_residual_memory_v2\",\"program_identity\":\"e5feb50a069ebe4c687543c98be775df145bdb60e79164b464e993ed8d44a2b4\",\"initial_dag_identity\":\"049d04d3c7448748f1d804d1c1ad6c3aa3b89e81f724b23cd3eeca85f34b026c\"},\"variables\":{\"funding_program\":{\"type\":\"entity\",\"demand\":\"project_info\",\"open\":true,\"scope\":{\"entity_scope\":\"SUPPLY project involving EHA\",\"time_scope\":\"project timeline\"}},\"start_date\":{\"type\":\"text\",\"demand\":\"project_info\",\"open\":true,\"scope\":{\"entity_scope\":\"SUPPLY project involving EHA\",\"time_scope\":\"project timeline\"}},\"duration\":{\"type\":\"text\",\"demand\":\"project_info\",\"open\":true,\"scope\":{\"entity_scope\":\"SUPPLY project involving EHA\",\"time_scope\":\"project timeline\"}}},\"requested_slots\":[\"funding_program\",\"start_date\",\"duration\"],\"requested_scopes\":{\"funding_program\":{\"entity_scope\":\"SUPPLY project involving EHA\",\"time_scope\":\"project timeline\"},\"start_date\":{\"entity_scope\":\"SUPPLY project involving EHA\",\"time_scope\":\"project timeline\"},\"duration\":{\"entity_scope\":\"SUPPLY project involving EHA\",\"time_scope\":\"project timeline\"}},\"output_contract\":{\"mode\":\"value\",\"result_type\":\"record\",\"entity_scope\":\"SUPPLY project involving EHA\",\"time_scope\":\"project timeline\",\"explanation\":\"none\",\"fields\":[\"funding_program\",\"start_date\",\"duration\"]},\"program_revision\":0,\"rule_binding\":null,\"supported_parents\":{},\"known_observations\":[{\"id\":\"fact_9f9d98e9f0bc016772f0d134\",\"stance\":\"support\",\"value\":\"HORIZON\",\"source_ids\":[\"s86\"],\"entity_scope\":\"SUPPLY project involving EHA\",\"time_scope\":\"project timeline\",\"parent_versions\":{},\"retract_ids\":[],\"reason\":\"The ASCERTAIN project page states 'Our consortium members gathered to kick off this HORIZON-funded initiative project.' The SUPPLY project involving EHA is the same as the ASCERTAIN project, as indicated by the project description and context. HORIZON is the funding program.\",\"variable\":\"funding_program\",\"revoked\":[],\"semantic_status\":\"model_judgment\"}],\"source_spans\":[[\"s63\",\"d1\",857,1089,\"JOIN US FOR OUR FINAL CONFERENCE\\n21. October 2026 in Brussels\\nFrom Evidence to Access: Rethinking Healthcare Decision-Making in Europe\\nAs the ASCERTAIN project comes to a close, we are pleased to invite you to our Final Conference. \",\"document\",[]],[\"s86\",\"d1\",8419,8816,\"Our consortium members gathered to kick off this HORIZON-funded initiative project.\\nContact\\nPlease get in touch with us if you have any questions or comments! We will get back to you as soon as possible.\\nFor research-related questions:\\nCarin Uyl-de Groot\\nProject Coordinator\\nErasmus University Rotterdam\\nln.rue.mphse@lyu\\nPhone: +31 10 4081583\\nFor general project questions:\\nMarcel Langone Marques\\n\",\"document\",[]],[\"s103\",\"d2\",1812,2064,\"Further, these tools will be developed, tested, and validated for three use cases, including precision cancer medicine, cell- and gene therapy, and medical devices (class IIb and III) or in vitro diagnostic (IVD) class D.\\nConsortium and Advisory Board\\n\",\"document\",[]],[\"s102\",\"d2\",1441,1812,\"It seeks to find a sustainable balance and reimbursement models, which will be adaptable to country-specific conditions.\\nThese tools will improve transparency and accountability of decision-making, reduce uncertainty for all stakeholders, reward innovation in areas of high unmet need, accelerate access for patients, and support long-term planning in a sustainable way. \",\"document\",[]],[\"s104\",\"d2\",2064,2385,\"The multinational, multidisciplinary ASCERTAIN consortium is complemented by an international advisory board consisting of key stakeholders, with whom the policy-supporting tools will be co-created. All tools will be hosted on a cloud-based, publicly accessible, user-friendly platform following open science principles.\\n\",\"document\",[]],[\"s105\",\"d2\",2385,2675,\"Discover the purpose of the ASCERTAIN project with this comprehensive overview of its goals, objectives, expected outcomes, partners, funding sources, and timeline.\\nBackground\\nThe affordability of newly approved innovative health technologies (IHTs) is challenging for many health systems. \",\"document\",[]],[\"s106\",\"d2\",2675,3059,\"Health care payers and pharmaceutical companies across European Union (EU) have explored different ways of defining payment for new products that ensure quick access of patients to new health technologies that provide adequate incentives to R&D efforts (both in rewarding R&D and guiding efforts to areas of higher social value) and that keeps health systems financially sustainable. \",\"document\",[]],[\"s107\",\"d2\",3059,3393,\"For example, the 2000 Pharmaceutical Strategy for Europe has also put one pillar on ensuring and enhancing the affordability of medicines, including those that address an unmet medical need. However, substantial differences in access to IHTs, including medicines and patient outcomes still exist across different countries in the EU. \",\"document\",[]],[\"s108\",\"d2\",3393,3558,\"This has significant implications for patient access for low-income countries as medicines are offered months and years later despite being worse population health. \",\"document\",[]],[\"s109\",\"d2\",3558,3901,\"With reference to the official list prices of first launch countries, it relates to higher prices, which are frequently not the real prices paid, since the latter have been negotiated down in confidential deals, commonly known as managed entry agreements (MEA). This contradicts the idea of “Equal access to health care” in the member states. \",\"document\",[]],[\"s110\",\"d2\",3901,4271,\"Furthermore, uncertainty on the effectiveness and costeffectiveness of IHTs is increasing as the number of medicines approved by the European Medicine Agency (EMA) in the absence of phase III randomised controlled trial (RCT) data is increasing. A new aim is EU’s strategic approach in 2019 to reduce the significant risks of pharmaceutical residues in the environment. \",\"document\",[]],[\"s111\",\"d2\",4271,4551,\"From the payer’s perspective to create incentives to green manufacturing, it is also desirable to be aware of the environmental impact medical products may have and to include this data, e.g., in new cost-effectiveness models.\\nDeveloping a policy support tool für decision-makers\\n\",\"document\",[]],[\"s112\",\"d2\",4551,4916,\"In ASCERTAIN, we will co-create and develop a cloud-based publicly accessible ASCERTAIN policy support tool for decision-makers to improve access to IHTs, including medicines. It will include new models (pricing, (cost-)effectiveness, and reimbursement). Another target is to have data related to the environmental impact of health technologies’ entire life cycle. \",\"document\",[]],[\"s113\",\"d2\",4916,5208,\"This includes, e.g., drug/product discovery, production, supply chain and logistics, packaging and how products are disposed of at the end of product life. We will test the models with three use cases (UCs): precision cancer medicine (PCM), cell and gene therapies, and medical technologies. \",\"document\",[]],[\"s114\",\"d2\",5208,5568,\"We will follow the FAIR (findable, accessible, interoperable, and reusable) data principles, recognised across the EU. ASCERTAIN consortium will pro-actively collaborate with stakeholders, e.g., industry, clinicians, patients, policy makers, government, academia, regulatory bodies, and payers to ensure quality, awareness, and acceptance of developed models.\\n\",\"document\",[]],[\"s115\",\"d2\",5568,5716,\"ASCERTAIN will contribute to better anticipating and calculating pricing, health technology assessment (HTA) and reimbursement conditions for IHTs. \",\"document\",[]],[\"s116\",\"d2\",5716,5993,\"ASCERTAIN policy tool features essential elements for long-term planning and incentives for economic entrepreneurship and takes into account the stakeholder preferences, e.g., faster and broader access for patients, transparency in methodology and decision-support structures. \",\"document\",[]],[\"s117\",\"d2\",5993,6278,\"Furthermore, it’s an open-access tool reducing uncertainties for all stakeholders, reward for innovation and investing in areas of unmet need. It has both value- and cost-based elements, elements to stimulate a “greener” production, adaptable to country-specific conditions.\\nRead more\\n\",\"document\",[]],[\"s118\",\"d2\",6278,6640,\"Methodology: Developing, Testing, and Implementing Models and Policies for Affordable and Sustainable Health Technologies\\nASCERTAIN will develop, test, review and quality-check models and policies for pricing, (cost -) effectiveness and budget impact and reimbursement for three UCs: precision cancer medicine, cell and gene therapies, and medical technologies. \",\"document\",[]],[\"s119\",\"d2\",6640,6946,\"The reviewed and quality-checked models will be integrated to an open-access web-based ASCERTAIN policy support tool, covering new pricing models and policies of new technologies, a broad HTA framework including cost-effectiveness and budget impact calculations, and new reimbursement and payment schemes. \",\"document\",[]],[\"s120\",\"d2\",6946,7114,\"In addition, the project will develop blueprints for country-specific adaptations and formulate recommendations for existing policy revisions at EU and national level. \",\"document\",[]],[\"s121\",\"d2\",7114,7447,\"ASCERTAIN uses on a multistakeholder approach and will bring together stakeholders from e.g., industry, government, policy makers, regulators, HTA entities, payers, health care professionals and patients to cooperate and participate in the dialogue, decision making, and implementation of developed solutions throughout the project. \",\"document\",[]],[\"s122\",\"d2\",7447,7738,\"ASCERTAIN concept consists of four blocks: ASCERTAIN framework (WP3), Algorithms for models and policies (WP 4, 5 & 6), technical component (WP7) and recommendations (WP 4, 5 & 6) which are explained in the section below. Figure 2 also shows the correspondence between the different blocks. \",\"document\",[]],[\"s123\",\"d2\",7738,8072,\"After project completion, it will offer a proven and scalable solution, from which different stakeholders can adopt the tool based on the country’s specific needs. In the following chapters we present the project components in more detail and the methodology for development, testing, review, and quality-check is outlined.\\nRead more\\n\",\"document\",[]],[\"s124\",\"d2\",8072,8369,\"Our Goal: Improving Affordability and Sustainability of Innovative Health Technologies through the ASCERTAIN Project\\nThe ASCERTAIN project aims to bring about significant improvements in the affordability and sustainability of innovative health technologies, including pharmaceuticals, in Europe. \",\"document\",[]],[\"s125\",\"d2\",8369,8600,\"The project will develop novel (algorithmic) pricing models and policies that can be adapted to innovative health technology, and test and validate the ASCERTAIN framework through three use cases, with input from key stakeholders. \",\"document\",[]],[\"s126\",\"d2\",8600,8815,\"This will lead to improvements in cost effectiveness and budget impact models for new health technologies, ensuring that efficacy, affordability, sustainability, and patient coverage and accessibility are improved. \",\"document\",[]],[\"s127\",\"d2\",8815,9105,\"The ASCERTAIN framework will also support the development of dynamic and cyclic reimbursement procedures with new methods to define thresholds, and evaluate the impact of these procedures in terms of equitable access, payer risk, and the values and preferences of EU patients and citizens. \",\"document\",[]],[\"s128\",\"d2\",9105,9296,\"Additionally, the project will create a novel algorithmic clinical, cost-effectiveness, and budget impact model that incorporates the entire health technology life cycle in such assessments. \",\"document\",[]],[\"s129\",\"d2\",9296,9679,\"Finally, the ASCERTAIN project will result in a publicly accessible support tool for policy decision making concerning the adaptation of new health technologies, and provide new knowledge and best practices for stakeholder engagement in developing cost-effective and affordable health innovations.\\nRead more\\nContact\\nPlease get in touch with us if you have any questions or comments! \",\"document\",[]],[\"s130\",\"d2\",9679,10071,\"We will get back to you as soon as possible.\\nFor research-related questions:\\nCarin Uyl-de Groot\\nProject Coordinator\\nErasmus University Rotterdam\\nln.rue.mphse@lyu\\nPhone: +31 10 4081583\\nFor general project questions:\\nMarcel Langone Marques\\nProject Manager\\nErasmus University Rotterdam\\nln.rue@seuqramenognal.lecram\\nPhone: +31 10 4081583\\nFor communications:\\nLena Jessen\\nProject Manager\\nOptiMedis\\n\",\"document\",[]],[\"s131\",\"d2\",10071,10456,\"ed.sidemitpo@nessej.l\\nPhone: +49 40 226211490\\nSUPPORT\\nLegal Notice\\nPrivacy Policy\\nCookie Policy\\nSITEMAP\\nASCERTAIN Project\\nAbout\\nImpact\\nWork Packages\\nConsortium\\nAdvisory Board\\nFinal Conference\\nNews & Events\\nFor Patients\\nResults\\nContact\\nEnglish\\nDeutsch (German)\\nNorsk bokmål (Norwegian Bokmål)\\nRomână (Romanian)\\nHrvatski (Croatian)\\nFrançais (French)\\nNederlands (Dutch)\\nEspañol (Spanish)\\n\",\"document\",[]],[\"s143\",\"d3\",584,956,\"With a background in International Relations (MA, University of Utrecht) and public affairs, Robin oversees EHA’s policy, advocacy and regulatory work as well as its partnerships and alliances. He is active on several committees and working groups of the BioMed Alliance, the European Cancer Organisation and Rare Cancers Europe and a member of the EMA HCP Working Party.\\n\",\"document\",[]],[\"s142\",\"d3\",345,584,\"Robin Doeswijk is Head of European Affairs at the European Hematology Association (EHA), which brings together and represents hematology professionals – including clinicians, diagnosticians and researchers – from across Europe and beyond. \",\"document\",[]],[\"s144\",\"d3\",956,1107,\"The priority goal of EHA’s policy and regulatory work is improving affordable and equal access to innovative therapies for patients throughout Europe. \",\"document\",[]],[\"s145\",\"d3\",1107,1502,\"In this context, two main areas of attention for Robin and the European Affairs team are the emerging European framework for Health Technology Assessment (HTA) and the challenges around cost-benefit assessment and pricing of new medicines (see EHA’s position paper on Fair Pricing).\\nRead more\\nGauthier Quinonez\\nGauthier Quinonez is a Policy Officer at the European Hematology Association (EHA). \",\"document\",[]],[\"s146\",\"d3\",1502,1900,\"Over the past 4 years, he has worked in Project Management and Public Policy. At EHA, his portfolio concerns Substances of Human Origins, rare diseases and pricing and reimbursement in hematology.\\nRead more\\nContact\\nPlease get in touch with us if you have any questions or comments! We will get back to you as soon as possible.\\nFor research-related questions:\\nCarin Uyl-de Groot\\nProject Coordinator\\n\",\"document\",[]],[\"s147\",\"d3\",1900,2298,\"Erasmus University Rotterdam\\nln.rue.mphse@lyu\\nPhone: +31 10 4081583\\nFor general project questions:\\nMarcel Langone Marques\\nProject Manager\\nErasmus University Rotterdam\\nln.rue@seuqramenognal.lecram\\nPhone: +31 10 4081583\\nFor communications:\\nLena Jessen\\nProject Manager\\nOptiMedis\\ned.sidemitpo@nessej.l\\nPhone: +49 40 226211490\\nSUPPORT\\nLegal Notice\\nPrivacy Policy\\nCookie Policy\\nSITEMAP\\nASCERTAIN Project\\n\",\"document\",[]],[\"s148\",\"d3\",2298,2683,\"About\\nImpact\\nWork Packages\\nConsortium\\nAdvisory Board\\nFinal Conference\\nNews & Events\\nFor Patients\\nResults\\nContact\\nEnglish\\nStay up to date!\\nTwice a year we will be sending out regular newsletters on the status of our project.\\nEmail\\nLast name\\nFirst name\\nI have read the privacy policy and I want to receive the Newsletter.\\nSend\\nWe use an external service provider to send our newsletter. \",\"document\",[]],[\"s132\",\"d2\",10456,10806,\"Stay up to date!\\nTwice a year we will be sending out regular newsletters on the status of our project.\\nEmail\\nLast name\\nFirst name\\nI have read the privacy policy and I want to receive the Newsletter.\\nSend\\nWe use an external service provider to send our newsletter. You can find more information in our privacy policy.\\nThank you 