retract_ids\",\"reason\"],\"type\":\"object\"},\"type\":\"array\"},\"reading_status\":{\"enum\":[\"no_relevant_evidence\",\"evidence_assessment\"],\"type\":\"string\"},\"search_gaps\":{\"description\":\"Untried search directions only; permitted with empty observations and unresolved.\",\"items\":{\"minLength\":1,\"type\":\"string\"},\"minItems\":1,\"type\":\"array\"},\"unresolved\":{\"items\":{\"type\":\"string\"},\"maxItems\":0,\"type\":\"array\"},\"variable\":{\"enum\":[\"agreement_date\"],\"type\":\"string\"}},\"required\":[\"variable\",\"observations\",\"unresolved\",\"reading_status\"],\"type\":\"object\"},\"maxItems\":1,\"minItems\":1,\"type\":\"array\"}},\"required\":[\"slots\"],\"type\":\"object\"}"
