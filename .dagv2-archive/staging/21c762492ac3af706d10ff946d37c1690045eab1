ences might shape your own musical endeavors in the future."], "document_offset": 0, "logical_document_count": 2, "physical_batch_limit": 4, "score_contract": "pointwise", "score_space": "unit_interval", "sequence": 118, "elapsed_seconds": 0.03941202163696289}
