alue\",\"source_ids\",\"entity_scope\",\"time_scope\",\"parent_versions\",\"retract_ids\",\"reason\"],\"type\":\"object\"},\"type\":\"array\"},\"unresolved\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"variable\":{\"enum\":[\"event_experience\"],\"type\":\"string\"}},\"required\":[\"variable\",\"observations\",\"unresolved\"],\"type\":\"object\"},\"maxItems\":1,\"minItems\":1,\"type\":\"array\"}},\"required\":[\"slots\"],\"type\":\"object\"}"
