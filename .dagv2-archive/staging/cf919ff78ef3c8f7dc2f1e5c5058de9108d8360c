urce and resolution checks.\nNo-relevant-evidence forbids these review/resolution claims. search_gaps is only\nallowed for no_relevant_evidence. Terminal composition and audit use the ordinary\nprotocol without reading_status or search_gaps.\n\n\nReturn one complete JSON object matching this schema:\n{\"additionalProperties\":false,\"properties\":{\"audit_verdict\":{\"enum\":[\"supported\",\"unknown\",\"conflict\"],\"type\":\"string\"},\"final_prediction\":{\"type\":[\"string\",\"null\"]},\"semantic_answer\":{},\"slots\":{\"items\":{\"additionalProperties\":false,\"allOf\":[{\"else\":{\"anyOf\":[{\"properties\":{\"observations\":{\"minItems\":1}}}],\"not\":{\"required\":[\"search_gaps\"]}},\"if\":{\"properties\":{\"reading_status\":{\"const\":\"no_relevant_evidence\"}}},\"then\":{\"properties\":{\"observations\":{\"maxItems\":0},\"unresolved\":{\"maxItems\":0}}}}],\"oneOf\":[{\"properties\":{\"observations\":{\"items\":{\"allOf\":[{\"if\":{\"properties\":{\"stance\":{\"enum\":[\"support\",\"contradiction\"]}}},\"then\":{\"properties\":{\"entity_scope\":{\"const\":\"SUPPLY project involving EHA\"},\"time_scope\":{\"const\":\"project duration\"}}}}],\"else\":{\"properties\":{\"value\":{\"type\":\"null\"}}},\"if\":{\"properties\":{\"stance\":{\"const\":\"support\"}}},\"properties\":{\"retract_ids\":{\"maxItems\":0},\"stance\":{\"enum\":[\"support\",\"partial\",\"unknown\",\"irrelevant\"]}},\"then\":{\"properties\":{\"value\":{\"minLength\":1,\"type\":\"string\"}}}}},\"variable\":{\"const\":\"funding_program\"}}}],\"properties\":{\"observations\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"entity_scope\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"parent_versions\":{\"additionalProperties\":{\"type\":\"integer\"},\"type\":\"object\"},\"reason\":{\"type\":\"string\"},\"retract_ids\":{\"items\":{\"type\":\"string\"},\"type\":\"array\",\"uniqueItems\":true},\"source_ids\":{\"description\":\"Exact visible source_spans[].id aliases, such as s3; neve