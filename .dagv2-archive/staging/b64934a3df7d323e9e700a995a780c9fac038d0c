d original; otherwise leave it pending. Do not\ninvent agreement or call genuine partial/counter evidence irrelevant to close it.\n\n\nReturn one complete JSON object matching this schema:\n{\"additionalProperties\":false,\"properties\":{\"audit_verdict\":{\"enum\":[\"supported\",\"unknown\",\"conflict\"],\"type\":\"string\"},\"final_prediction\":{\"type\":[\"string\",\"null\"]},\"semantic_answer\":{},\"slots\":{\"items\":{\"additionalProperties\":false,\"allOf\":[{\"if\":{\"properties\":{\"resolved_obligation_ids\":{\"minItems\":1}},\"required\":[\"resolved_obligation_ids\"]},\"then\":{\"properties\":{\"unresolved\":{\"maxItems\":0}}}},{\"else\":{\"anyOf\":[{\"properties\":{\"observations\":{\"minItems\":1}}}],\"not\":{\"required\":[\"search_gaps\"]}},\"if\":{\"properties\":{\"reading_status\":{\"const\":\"no_relevant_evidence\"}}},\"then\":{\"properties\":{\"observations\":{\"maxItems\":0},\"resolved_obligation_ids\":{\"maxItems\":0},\"unresolved\":{\"maxItems\":0}}}},{\"if\":{\"properties\":{\"resolved_obligation_ids\":{\"minItems\":1}},\"required\":[\"resolved_obligation_ids\"]},\"then\":{\"properties\":{\"observations\":{\"items\":{\"properties\":{\"stance\":{\"enum\":[\"support\",\"contradiction\",\"irrelevant\"]}}}},\"reading_status\":{\"const\":\"evidence_assessment\"}}}}],\"oneOf\":[{\"properties\":{\"observations\":{\"items\":{\"allOf\":[{\"if\":{\"properties\":{\"stance\":{\"enum\":[\"support\",\"contradiction\"]}}},\"then\":{\"properties\":{\"entity_scope\":{\"const\":\"SUPPLY project involving EHA\"},\"time_scope\":{\"const\":\"project timeline\"}}}}],\"else\":{\"properties\":{\"value\":{\"type\":\"null\"}}},\"if\":{\"properties\":{\"stance\":{\"const\":\"support\"}}},\"properties\":{\"retract_ids\":{\"items\":{\"enum\":[\"fact_9f9d98e9f0bc016772f0d134\"]}}},\"then\":{\"properties\":{\"value\":{\"minLength\":1,\"type\":\"string\"}}}}},\"resolved_obligation_ids\":{\"maxItems\":0},\"variable\":{\"const\":\"funding_program\"}}},{\"properties\":{\"observati