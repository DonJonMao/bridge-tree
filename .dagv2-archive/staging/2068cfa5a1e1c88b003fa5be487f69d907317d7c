dices\": [], \"time_metadata\": {}}, {\"id\": \"s38\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 1903, \"end\": 2269, \"text\": \"Topics-in-Focus program\\nSupport for SWG scientific meetings\\nSWG Grants\\nHow to apply to join an SWG\\nWebinars and online groups\\nSWG Preceptorship Program\\nEHA Research Grants\\nEHA Bilateral Collaborative Grant\\nEHA Innovation Grant\\nEHA Kick-off Grant\\nEHA Research Mobility Grant\\nEHA Grants Hall of Fame\\nEHA Travel Grants\\nNon-EHA funding opportunities\\nScope of our grants\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s39\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 2269, \"end\": 2656, \"text\": \"Precision Hematology Topics-in-Focus program\\nHemoglobinopathies Topics-in-Focus program\\nTuesday, May 6, 2025\\nEHA Mentorship Program\\nMenu\\nClose\\nConnect & Network\\nEHA2027 Congress\\nEHA2027 registration\\nEHA2027 program\\nEHA2027 abstract submission\\nEHA2027 travel grants & abstract awards\\nEHA2027 sponsorship opportunities\\nEHA2027 details and deadlines\\nEHA2027 sustainability\\nCongress archive\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s40\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 2656, \"end\": 3051, \"text\": \"EHA2026 Perspectives Congress Report\\nEHA2026 gallery\\nEHA2025 Perspectives Congress Reports\\nEHA2025 gallery\\nEHA2024 Chair's wrap-up\\nEHA2024 report\\nEHA2024 gallery\\nEHA2023 report\\nEHA2023 gallery\\nScientific meetings\\nMembership\\nFull membership\\nJunior membership\\nTrial membership\\nHealthcare-affiliated professional membership\\nEmeritus membership\\nJoint EHA and national society membership\\nUsing MyEHA\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s41\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 3051, \"end\": 3448, \"text\": \"Clinical practice\\nOur guidelines initiative\\nGuidelines by areas of disease\\nEHA Guidelines app\\nEHA Clinical Guidelines Webinar Series\\nBedside Hematology – Rapid Reference\\nEducation & Training\\nEHA Campus\\nLearning paths\\nEuropean Hematology Curriculum\\nEntrustable Professional Activities\\nLighting the Flame Program\\nTests and tools\\nEHA Diagnosis\\nEHA Exam\\nProgress Test\\nMentoring and career development\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s42\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 3448, \"end\": 3835, \"text\": \"Career comparison tool\\nEHA Mentorship Program\\nMaster Class\\nResearch training programs\\nEHA-EMBO Lab Leadership Course\\nResearch & Innovation\\nHemaSphere\\nSpecialized Working Groups\\nSupport for SWG scientific meetings\\nSWG Grants\\nHow to apply to join an SWG\\nWebinars and online groups\\nSWG Preceptorship Program\\nGrants\\nEHA Research Grants\\nEHA Bilateral Collaborative Grant\\nEHA Innovation Grant\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s43\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 3835, \"end\": 4168, \"text\": \"EHA Kick-off Grant\\nEHA Research Mobility Grant\\nEHA Grants Hall of Fame\\nEHA Travel Grants\\nNon-EHA funding opportunities\\nScope of our grants\\nTopics-in-Focus program\\nPrecision Hematology Topics-in-Focus program\\nHemoglobinopathies Topics-in-Focus program\\nCongress\\nHemaSphere\\nAbout EHA\\nSearch\\nJoin EHA\\nLogin\\nHome\\nAbout EHA\\nNews & updates\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s44\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 4168, \"end\": 4489, \"text\": \"ASCERTAIN project for better pricing and reimbursement models enters final phase\\nLeft Sidebar\\n3 min read · July 23, 2026\\nJuly 23, 2026\\nShare\\nNews & updates\\nNews archive\\nASCERTAIN project for better pricing and reimbursement models enters final phase\\nInterview with EHA’s European Affairs Committee Member, Ariane Weinman\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s45\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 4489, \"end\": 4693, \"text\": \"ASCERTAIN project for better pricing and reimbursement models enters final phase\\nThe ASCERTAIN project is entering its final phase, with the final conference taking place on October 21, 2026 in Brussels.\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s46\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 4693, \"end\": 5014, \"text\": \"ASCERTAIN – Affordability and Sustainability improvements through new pricing, Cost- Effectiveness and ReimbursemenT models to Appraise INnovative health technologies – is an EU funded project focused on improving the affordability and accessibility of innovative health technologies by developing a policy support tool. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s47\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 5014, \"end\": 5354, \"text\": \"EHA is a consortium partner in the project, which aligns with our advocacy priority to promote affordable and equitable access to innovative therapies in hematology.\\nAccessibility and pricing of new health technologies in hematology\\nHigh prices of new health technologies impede access to treatments for many patients with blood disorders. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s48\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 5354, \"end\": 5723, \"text\": \"Health systems face the challenge of facilitating patient access to new health technologies while ensuring the system’s financial sustainability and providing incentives for innovation. Together with Myeloma Patients Europe and patient organizations for PNH and Sickle Cell Disease, EHA is representing the hematology field in the development of the ASCERTAIN project.\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s49\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 5723, \"end\": 6097, \"text\": \"The ASCERTAIN policy support tool\\nThe ASCERTAIN policy support tool aims to contribute to better anticipating and calculating pricing, health technology assessment (HTA), and reimbursement conditions for innovative health technologies (IHTs). The tool is hosted on a web-based publicly accessible platform and includes pricing, cost-effectiveness, and reimbursement models. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s50\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 6097, \"end\": 6484, \"text\": \"Additionally, environmental impact is considered in selected model components. The models are tested for three use cases: precision cancer medicine (PCM), cell and gene therapies, and medical technologies. To inform decision-making across different health systems, country-specific adaptation is available to varying degrees depending on the model.\\nRead more about ASCERTAIN\\nWhat’s next\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s51\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 6484, \"end\": 6720, \"text\": \"In our last meeting in April, the ASCERTAIN consortium came together to discuss our progress, connect with external stakeholders, and prepare for the final meeting. The Final Conference is taking place on October 21, 2026, in Brussels. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s52\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 6720, \"end\": 6975, \"text\": \"It will bring together insurance organisations, policymakers and regulators, industry representatives, patient representatives, academics, and clinicians to showcase the policy support tool and discuss ASCERTAIN’s key findings and policy recommendations.\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s53\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 6975, \"end\": 7250, \"text\": \"The conference will be a valuable opportunity to engage with stakeholders, increase awareness of the policy support tool, and work towards more equitable access to new health technologies in Europe.\\nLearn more about the final conference\\nWhat is ASCERTAIN doing for patients?\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s54\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 7250, \"end\": 7536, \"text\": \"Myeloma Patients Europe (MPE) represents patient interests in the project and seeks feedback from patients and patient advocates on its results. In addition, the Advisory Board includes representatives of various patient organizations.\\nASCERTAIN aims to support patients by working on:\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s55\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 7536, \"end\": 7917, \"text\": \"Fairer pricing, reimbursement, and cost-effectiveness models to ensure more patients can access medicines at fair prices\\nBetter ways for regulatory, assessment, and reimbursement processes to support patient access to health technologies\\nBetter ways to assess and manage uncertainty in clinical evidence to support transparent decision-making about patient access to new medicines\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s56\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 7917, \"end\": 8305, \"text\": \"Find more patient resources\\nShare\\nNews & updates\\nNews archive\\nASCERTAIN project for better pricing and reimbursement models enters final phase\\nInterview with EHA’s European Affairs Committee Member, Ariane Weinman\\nJoin EHA\\nFull membership\\nJunior membership\\n60-day trial\\nGet involved\\nCareer development\\nScientific meetings\\nAbout us\\nMission and vision\\nJobs\\nSponsor EHA\\nContact us\\nFollow us\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s57\", \"doc_id\": \"web-a1a4b9296231df67293c7260\", \"start\": 8305, \"end\": 8480, \"text\": \"Privacy statement\\nTerms and conditions\\nSubscribe\\nCopyright © 2026\\nBecome an EHA Mentor\\nEHA Mentorship Program\\nDiscover the rewards of mentoring\\nApply by October 29\\nApply today\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s58\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 0, \"end\": 389, \"text\": \"ASCERTAIN – IMPROVING ACCESS TO INNOVATIVE HEALTH TECHNOLOGIES\\nASCERTAIN – IMPROVING ACCESS TO INNOVATIVE HEALTH TECHNOLOGIES\\nASCERTAIN Project\\nAbout\\nImpact\\nWork Packages\\nConsortium\\nAdvisory Board\\nFinal Conference\\nNews & Events\\nFor Patients\\nResults\\nContact\\nEnglish\\nDeutsch (German)\\nNorsk bokmål (Norwegian Bokmål)\\nRomână (Romanian)\\nHrvatski (Croatian)\\nFrançais (French)\\nNederlands (Dutch)\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s59\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 389, \"end\": 458, \"text\": \"Español (Spanish)\\nIMPROVING ACCESS TO\\nINNOVATIVE HEALTH TECHNOLOGIES\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s60\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 458, \"end\": 857, \"text\": \"ASCERTAIN (Affordability and Sustainability improvements through new pricing, Cost- Effectiveness and ReimbursemenT models to Appraise INnovative health technologies) addresses the need of patients, physicians, payers, regulators, and manufacturers to improve the affordability and accessibility to innovative health technologies (including pharmaceuticals) in Europe.\\nFind out how you can benefit!\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s61\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 857, \"end\": 1089, \"text\": \"JOIN US FOR OUR FINAL CONFERENCE\\n21. October 2026 in Brussels\\nFrom Evidence to Access: Rethinking Healthcare Decision-Making in Europe\\nAs the ASCERTAIN project comes to a close, we are pleased to invite you to our Final Conference. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s62\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 1089, \"end\": 1321, \"text\": \"The event will bring together policymakers, HTA bodies, payers, patient representatives, industry, researchers, and healthcare professionals to explore new approaches to improving access to innovative health technologies in Europe.\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s63\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 1321, \"end\": 1540, \"text\": \"Throughout the day, participants will discover ASCERTAIN’s novel pricing, cost-effectiveness, and reimbursement models, developed to support more transparent, evidence-based, and sustainable healthcare decision-making. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s64\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 1540, \"end\": 1870, \"text\": \"These approaches will be showcased through the project’s three healthcare use cases – personalised cancer medicines, CAR T-cell therapies, and Next Generation Sequencing (NGS) tests for precision oncology – as well as the open-access Policy Support Tool that integrates these models into a practical decision-support environment.\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s65\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 1870, \"end\": 2161, \"text\": \"Held at The Dominican in Brussels, the conference will provide a forum for dialogue, collaboration, and reflection on the future of equitable access, affordability, and healthcare innovation in Europe.\\nAttendance at the conference is free of charge.\\nMore Info\\nBooking\\nFAQ\\nWhat is ASCERTAIN?\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s66\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 2161, \"end\": 2477, \"text\": \"ASCERTAIN is a project aimed at helping people get better access to new health technologies such as medicines, medical devices, and tests. The project is creating a tool that can be used by decision-makers to understand the cost and value of these new health technologies.\\nWhat is the ASCERTAIN policy support tool?\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s67\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 2477, \"end\": 2866, \"text\": \"The tool will be accessible to everyone on the internet and will have information about the cost and value of these new health technologies. It will also consider the impact on the environment. The project will work with patients, industry, policy makers, and payers to make sure the tool is good quality and useful.\\nWhy is the affordability of innovative health technologies a challenge?\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s68\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 2866, \"end\": 3243, \"text\": \"It’s a challenge for many countries in the European Union to afford new health technologies because they are often expensive and not everyone has equal access to them. This tool will help decision-makers understand how much a technology should cost, the added value it provides for patients, and its potential impact on the health care budget.\\nWhat are the goals of ASCERTAIN?\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s69\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 3243, \"end\": 3642, \"text\": \"The goal of ASCERTAIN is to make it easier for people to understand the cost and value of new health technologies. The tool will be open to everyone and will be able to be adapted to different countries’ needs. It will have information about the cost and value of these technologies and will encourage “greener” production.\\nWOULD YOU PREFER TO READ THIS PAGE IN A DIFFERENT LANGUAGE?\\nEvents\\n21\\n-\\n21\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s70\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 3642, \"end\": 4011, \"text\": \"Oct\\nASCERTAIN Final Conference\\nFrom Evidence to Access: Rethinking Healthcare Decision-Making in Europe is the motto of our finale ASCERTAIN conference. Join us in Brussels this October.\\nVIDEO\\nNews\\nASCERTAIN NEWSLETTER 6\\nWelcome to the sixth edition of the ASCERTAIN newsletter!\\nRead more\\nASCERTAIN Position Papers on Pricing, Modelling and Reimbursement Now Available\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s71\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 4011, \"end\": 4277, \"text\": \"We are pleased to announce the publication of three ASCERTAIN position papers addressing key challenges in the pricing, assessment, and reimbursement of innovative health technologies.\\nRead more\\nNew ASCERTAIN Position Paper on Pricing Innovative Health Technologies\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s72\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 4277, \"end\": 4541, \"text\": \"ASCERTAIN has published a new position paper summarising key findings and recommendations from Work Package 4 on pricing innovative health technologies.\\nRead more\\nNew ASCERTAIN video series explains how medicines are priced, evaluated and made available in Europe\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s73\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 4541, \"end\": 4840, \"text\": \"ASCERTAIN has launched a new animated video series designed to make complex topics around medicine pricing, cost-effectiveness, reimbursement, and decision-making in the European Union easier to understand.\\nRead more\\nNew ASCERTAIN Video Series: How Are Medicines Priced and What Makes a Price Fair?\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s74\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 4840, \"end\": 5164, \"text\": \"We have launched a new series of short educational videos exploring how medicines are priced, how prices are regulated, and how patient perspectives shape decisions on access.\\nRead more\\nASCERTAIN NEWSLETTER 5\\nWelcome to the fifth edition of the ASCERTAIN newsletter! This edition highlights how that vision is taking shape. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s75\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 5164, \"end\": 5544, \"text\": \"In our interview, Professor Tomas Tesar and Dr Mirjana Huic discuss cost-effectiveness thresholds and the challenge of balancing innovation with equity. Their insights echo ASCERTAIN’s wider mission — ensuring that value assessments reflect both scientific and societal priorities.\\nRead more\\nPresentation of New HTA Methodological Guideline for Slovakia at the Ministry of Health\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s76\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 5544, \"end\": 5872, \"text\": \"On September 30th, the Slovak Ministry of Health hosted a seminar presenting the new national HTA methodological guideline, organized by Professor Tomáš Tesař, with contributions from ASCERTAIN and international experts highlighting the relevance of cost-effectiveness thresholds.\\nRead more\\nASCERTAIN Consortium Meeting in Oslo\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s77\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 5872, \"end\": 6259, \"text\": \"On 30 June 2025, the ASCERTAIN Consortium held its Stakeholder Day in Oslo, bringing together experts from academia, healthcare, industry, and policy to discuss sustainable access to innovative health technologies (IHTs). The event focused on refining access-based pricing, cost-effectiveness, and reimbursement models by aligning them with stakeholder needs and expectations.\\nRead more\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s78\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 6259, \"end\": 6659, \"text\": \"ASCERTAIN Website Now Available in 8 Languages\\nWe are happy to announce that the ASCERTAIN project website is now accessible in eight different languages:\\nEnglish, German, Dutch, Norwegian, Romanian, Croatian, Spanish, and French.\\nRead more\\nTake Part in Our Survey on Access-Based Pricing for Innovative Medicines\\nThis survey is part of the ASCERTAIN Project and will remain open until 18 July 2025.\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s79\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 6659, \"end\": 7017, \"text\": \"Read more\\nwatch our videos to learn more about the project\\nDiscover the making of the six-part series ‘3 Things About’. In six videos we aim to make complex issues more accessible, fostering a deeper understanding of the challenges and opportunities in topics around ASCERTAIN.\\n“3 Things About the Value of New Cancer Drugs” – The sixth video in our series! \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s80\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 7017, \"end\": 7345, \"text\": \"This video explores how different stakeholders define the value of new cancer drugs.\\n“3 Things About Cost-Effectiveness” – The fifth video in our series! This video explores cost-effectiveness analysis—a key method for assessing if treatments provide good value.\\n3 Things About Reimbursement” is the fourth video in our series. \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s81\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 7345, \"end\": 7718, \"text\": \"In this video, we explore the complexities of drug reimbursement—a key factor in ensuring patient access to new medicines.\\n“3 Things About Pricing Of New Drugs” – The third video in our series! In this video, we explore the factors that influence drug pricing — a crucial topic in healthcare affordability.\\n“3 Things About Tiered Pricing” – The second video in our series! \", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}, {\"id\": \"s82\", \"doc_id\": \"web-f9552075330dd435c5a02363\", \"start\": 7718, \"end\": 8063, \"text\": \"In this video, we break down the concept of tiered pricing—a strategy used to set different drug prices across countries and patient groups.\\n“3 Things About Market Access” – The first video in our series! In this video, we dive into the crucial concept of market access—a vital process for making new drugs and treatments available to patients.\\n\", \"source_role\": \"document\", \"source_message_indices\": [], \"time_metadata\": {}}], \"retraction_targets\": [], \"candidates\": [{\"candidate_id\": \"462e5153481d629967fb25c049ac7767998e14fe3f1e1bd72cedff51c818f3da\", \"observation\": {\"id\": \"obs_funding_1\", \"stance\": \"irrelevant\", \"value\": null, \"source_ids\": [\"s46\"], \"entity_scope\": \"SUPPLY project involving EHA\", \"time_scope\": \"project timeline\", \"parent_versions\": {}, \"retract_ids\": [], \"variable\": \"funding_program\"}, \"claim_to_check\": \"The cited originals warrant inapplicability to the requested entity/event/relation or attribute. Assess that inapplicability claim, not whether they support an answer. Mere answer absence does not prove inapplicability; reject this stance if it discards genuine scoped support, partial evidence or counterevidence.\"}, {\"candidate_id\": \"9f9ae74cac7b28014a7653c0c769973632769192779757a48a16bed48221e565\", \"observation\": {\"id\": \"obs_start_1\", \"stance\": \"irrelevant\", \"value\": null, \"source_ids\": [\"s44\", \"s51\"], \"entity_scope\": \"SUPPLY project involving EHA\", \"time_scope\": \"project timeline\", \"parent_versions\": {}, \"retract_ids\": [], \"variable\": \"start_date\"}, \"claim_to_check\": \"The cited originals warrant inapplicability to the requested entity/event/relation or attribute. Assess that inapplicability claim, not whether they support an answer. Mere answer absence does not prove inapplicability; reject this stance if it discards genuine scoped support, partial evidence or counterevidence.\"}, {\"candidate_id\": \"d6fcfacd9f12630eb5058122f3b9a2140d71eafd0e2ffaf00d181e25e994514d\", \"observation\": {\"id\": \"obs_duration_1\", \"stance\": \"irrelevant\", \"value\": null, \"source_ids\": [\"s45\", \"s51\"], \"entity_scope\": \"SUPPLY project involving EHA\", \"time_scope\": \"project timeline\", \"parent_versions\": {}, \"retract_ids\": [], \"variable\": \"duration\"}, \"claim_to_check