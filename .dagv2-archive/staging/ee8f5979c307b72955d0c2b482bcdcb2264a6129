          "s23": {
            "id": "s23",
            "doc_id": "hotpotqa:2065",
            "start": 592,
            "end": 821,
            "text": "From there on began her professional partnership with Kapil Sharma that is still going on. From June 2013 to January 2016 she was seen as Manju Sharma in Comedy Nights with Kapil where she played the role of Kapil Sharma's wife. ",
            "source_role": "document",
