ience\":{\"type\":\"text\",\"demand\":\"event_experience\",\"open\":true,\"evidence_semantics\":\"personal_history_summary\",\"scope\":{\"entity_scope\":\"user\",\"time_scope\":\"recent\"}},\"user_interests\":{\"type\":\"text\",\"demand\":\"user_interests\",\"open\":true,\"evidence_semantics\":\"personal_history_summary\",\"scope\":{\"entity_scope\":\"user\",\"time_scope\":\"lifetime\"}},\"constraints\":{\"type\":\"text\",\"demand\":\"constraints\",\"open\":true,\"evidence_semantics\":\"personal_history_summary\",\"scope\":{\"entity_scope\":\"user\",\"time_scope\":\"recent\"}},\"changes\":{\"type\":\"text\",\"demand\":\"changes\",\"open\":true,\"evidence_semantics\":\"personal_history_summary\",\"scope\":{\"entity_scope\":\"user\",\"time_scope\":\"lifetime\"}},\"response\":{\"type\":\"text\",\"demand\":\"response\",\"scope\":{\"entity_scope\":\"user\",\"time_scope\":\"current\"}}},\"requested_slots\":[\"event_experience\",\"user_interests\",\"constraints\",\"changes\",\"response\"],\"requested_scopes\":{\"event_experience\":{\"entity_scope\":\"user\",\"time_scope\":\"recent\"},\"user_interests\":{\"entity_scope\":\"user\",\"time_scope\":\"lifetime\"},\"constraints\":{\"entity_scope\":\"user\",\"time_scope\":\"recent\"},\"changes\":{\"entity_scope\":\"user\",\"time_scope\":\"lifetime\"},\"response\":{\"entity_scope\":\"user\",\"time_scope\":\"current\"}},\"output_contract\":{\"mode\":\"semantic\",\"result_type\":\"text\",\"entity_scope\":\"user\",\"time_scope\":\"current\",\"explanation\":\"semantic\"},\"program_revision\":0,\"rule_binding\":null,\"supported_parents\":{\"event_experience\":{\"value\":\"The user has had mixed recent experiences with community event planning. They found planning a book swap overwhelming and disheartening due to logistical complexities, but successfully conducted an engaging author interview event that felt rewarding. They also joined a reading marathon for charity that fostered a strong sense of community, and started a regular volunteering schedule at a local library that they find fulfilling. However, they were disappointed by a community buying group that lacked engagement and clear direction.\",\"version\":1,\"source_ids\":[\"s40\",\"s21\",\"s13\",\"s5\",\"s20\",\"s39\",\"s32\",\"s12\",\"s47\",\"s22\",\"s48\",\"s30\",\"s31\",\"s4\",\"s3\",\"s49\"],\"demand\":\"event_experience\",\"type\":\"text\",\"scope\":{\"entity_scope\":\"user\",\"time_scope\":\"recent\"}},\"user_interests\":{\"value\":\"The user has a strong and enduring interest in community involvement, particularly through literature and reading-related activities. They have organized a book swap (though found it overwhelming), participated in a reading marathon for charity (positive experience), conducted an interview with a well-known author leading to a community event (positive experience), started regular volunteering at a local library (positive experience), curated a list of must-read books for a community newsletter (positive experience), helped organize book recommendations for library patrons (positive experience), joined a local book club focused on contemporary fiction (positive experience), attended a national literature festival (positive experience), and formed a partnership with local artists to create book-themed merchandise for events (positive experience). They also joined a community buying group but found it less engaging. Their values include fostering literacy, community connection, and shared experiences around books.\",\"version\":2,\"source_ids\":[\"s78\",\"s40\",\"s105\",\"s121\",\"s104\",\"s21\",\"s13\",\"s5\",\"s79\",\"s20\",\"s39\",\"s32\",\"s58\",\"s113\",\"s95\",\"s77\",\"s12\",\"s47\",\"s22\",\"s48\",\"s30\",\"s57\",\"s31\",\"s120\",\"s4\",\"s3\",\"s112\",\"s49\",\"s96\"],\"demand\":\"user_interests\",\"type\":\"text\",\"scope\":{\"entity_scope\":\"user\",\"time_scope\":\"lifetime\"}},\"constraints\":{\"value\":\"The user faced significant stress and overwhelm while planning a community book swap, due to the complexities of coordinating genres, managing schedules, ensuring enough participants, and devising a fair distribution system. This led to disheartenment about pursuing similar events. Additionally, the user found a community buying group less engaging than expected, with stagnant conversations and a lack of clear focus or direction, leading to disappointment. These challenges could affect continuing community event planning.\",\"version\":1,\"source_ids\":[\"s21\",\"s5\",\"s20\",\"s47\",\"s22\",\"s48\",\"s4\",\"s3\",\"s49\"],\"demand\":\"constraints\",\"type\":\"text\",\"scope\":{\"entity_scope\":\"user\",\"time_scope\":\"recent\"}},\"changes\":{\"value\":\"The user initially found community event planning exciting but became overwhelmed and disheartened by the complexities of organizing a book swap, including coordinating genres, schedules, and fair distribution. They later had a positive experience organizing a successful author interview event that generated community excitement, making the effort feel worthwhile. They also joined a reading marathon for charity, which provided a strong sense of community and shared purpose. However, they had two negative experiences with a community buying group, finding it less engaging and stagnant due to lack of dynamic interactions and clear direction. Overall, the user has experienced both rewarding and disappointing community involvement, with the positive events being well-organized and fostering connection, while the negative ones lacked engagement and structure.\",\"version\":1,\"source_ids\":[\"s21\",\"s13\",\"s5\",\"s20\",\"s32\",\"s12\",\"s47\",\"s22\",\"s48\",\"s30\",\"s31\",\"s4\",\"s3\",\"s49\"],\"demand\":\"changes\",\"type\":\"text\",\"scope\":{\"entity_scope\":\"user\",\"time_scope\":\"lifetime\"}}},\"known_observations\":[{\"id\":\"fact_27999d91390f0675687c5856\",\"stance\":\"support\",\"value\":\"The user has had mixed recent experiences with community event planning. They found planning a book swap o