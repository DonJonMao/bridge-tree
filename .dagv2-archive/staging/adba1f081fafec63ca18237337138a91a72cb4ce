          "s20": {
            "id": "s20",
            "doc_id": "hotpotqa:1002",
            "start": 393,
            "end": 633,
            "text": "The airport divides the area of Monte and Pau Pique (in the headlands) and the central community of Santa Cruz das Flores (located on a \"fajã\", or geological debris field, from the Porto do Boqueirão to Porto Velho) along the eastern coast.",
            "source_role": "document",
