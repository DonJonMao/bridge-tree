<!-- start Simple Custom CSS and JS -->
<style type="text/css">
/* booking ausblenden  **/
/*.em-event-bookings {display:none}*/
.em-event.em-item {display:flex; flex-direction:row; margin-bottom:43px; padding-right:0;padding-left:30px}
.em-event.em-item:nth-child(odd) {display:flex; flex-direction:row-reverse; padding-left:0; padding-right:30px}
.em-event.em-item.em-item-single:nth-child(odd) {padding-right:0; flex-direction:column}
.em-event.em-item.em-item-single {padding-left:0}
.em-meta-dates {width:22%;padding-top:40px}
.em-meta-dates .date {display: grid;    grid-template-columns: 1fr 1fr;    grid-column-gap: 15px; height:120px;}
.em-meta-dates .date .day {background:#86b8bd; border-top-left-radius:50%; border-bottom-left-radius:50%;  color:#3b3e85}
.em-event.em-item:nth-child(3n+2) .em-meta-dates .date .day {background:#393c84; color:#048ea3} 
.em-event.em-item:nth-child(3n+3) .em-meta-dates .date .day {background:#393c84; color:#e85d6b} 
.em-meta-dates .date .month {background:#e85d6b; border-top-right-radius:50%; border-bottom-right-radius:50%; color:white}
.em-event.em-item:nth-child(3n+3) .em-meta-dates .date .month {background:#048ea3; } 
.em-meta-dates .date .day, .em-meta-dates .date .month {/*line-height: 120px; */ display: flex;
vertical-align: middle;
align-items: center;
justify-content: center;   text-align: center; font-size:36px; font-weight:600;}
.em-item-info {width:78%; display: flex;    flex-direction: row; /*padding-left:14%; padding-right:0; border-top:2px solid #85b8bd */}
.em-event.em-item:nth-child(even) .em-item-info {display: flex;    flex-direction: row-reverse;/* padding-left:0; padding-right:14%*/ }
.em-item-info h3.em-item-title { color:#048ea3; font-size:24px; line-height:1.33}
.em-item-info .em-event-meta.em-item-meta {}
.em-item-info .em-event-meta.em-item-meta .em-item-desc {}
.em-content {width:85%; padding-left:15%; padding-right:0; border-top:2px solid #85b8bd; padding-top:40px}
.em-event.em-item:nth-child(1) .em-content {border-top:none;}
.em-event.em-item:nth-child(even) .em-content {padding-left:0; padding-right:15%;}
.em-item-actions {width:15%}
.em-item-read-more {width:45px; height:45px; display:block; background:url(https://www.access2meds.eu/wp-content/uploads/2023/03/plus.svg) no-repeat; background-size:contain; margin:40px auto;}
/**** formulare    ****/
.em-event-bookings h2 {margin-bottom:30px}
.em-booking-form input:not([type="checkbox"]), .em-booking-form select{
background: #fff;    border: none;    border-radius: .25em;    box-shadow: inset 0 2px 1px rgba(0, 0, 0, .05), inset 0 0 0 1px rgba(0, 0, 0, .2);    color: #666;
font-family: inherit;    font-size: 1em;    font-weight: 400;    height: 2.5em;    line-height: 1.5;    margin: 0;	border-radius: 999px !important;    height: 46px;    outline: none;
padding: .5em;    vertical-align: top;    width: 100%;	}
h3.em-booking-section-title {margin-top: 30px;    margin-bottom: 10px; font-size:24px}
.em-form-submit.em-booking-submit.em-button {    margin-top: 30px;    margin-bottom: 10px;  background-color: #393C84; color:white}
.em-form-submit.em-booking-submit.em-button:hover {cursor:pointer}
.em-booking-message { padding-top:100px;margin-bottom:30px; }
.em-booking-message-success { color:green;}
.em-booking-message-error p {color:red}
/*  */
@media (max-width:980px) {
.em-meta-dates .date, .em-meta-dates .date .day, .em-meta-dates .date .month {height:80px; font-size:24px; /*line-height:80px;*/}
.em-meta-dates .date {grid-column-gap: 10px;}
.em-item-read-more {    width: 40px;		height: 40px;}
.em-item-info h3.em-item-title {    font-size: 22px; }
.em-content {padding-left: 10%;}
.em-event.em-item:nth-child(even) .em-content {    padding-right: 10%;}
}
@media (max-width:640px) {
.em-meta-dates {    width: 27%;}
.em-item-info {		width: 73%;}
.em-item-desc {display:none;}
.em-item-read-more {    width: 30px;		height: 30px;}
}
@media (max-width:599px) {
.em-meta-dates .date, .em-meta-dates .date .day, .em-meta-dates .date .month {height:60px; font-size:20px; line-height:0.8 /*line-height:60px;*/}
}
@media (max-width:400px) {
.em-item-actions {    width: 0; display:none;}
.em-content {width:97%}
.em-meta-dates .date, .em-meta-dates .date .day, .em-meta-dates .date .month {height:40px; font-size:14px; /*line-height:40px;*/}
.em-meta-dates .date {grid-column-gap: 5px;}
}
</style>
<!-- end Simple Custom CSS and JS -->
