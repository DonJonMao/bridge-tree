<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" /><script>
jQuery(function($){
function fixConsent() {
$('.em-consent-checkbox label').each(function () {
const label = $(this);
if (label.data('done')) return;
label.data('done', true);
const input = label.find('input');
const link  = label.find('a');
// neuen Inhalt sauber aufbauen
label.empty().append(input);
label.append(
' I have read and accept the '
);
if (link.length) {
label.append(link);
} else {
label.append('Privacy Policy');
}
label.append(', including the provisions on the processing of personal data and the handling of photographs and videos.');
});
}
function fixSuccess() {
$('.em-booking-message-success').text(
'Thank you for registering for this event. You will receive a confirmation email shortly.'
);
}
// initial
fixConsent();
fixSuccess();
// nach AJAX
jQuery(document).ajaxComplete(function () {
setTimeout(function(){
fixConsent();
fixSuccess();
}, 100);
});
});
</script>
<script>
//klappfunktion speaker final conference
jQuery(function($) {
$('.speaker-toggle').on('click', function(e) {
e.preventDefault();
var $button = $(this);
var isOpen = $button.hasClass('is-open');
$('.speaker-more').toggleClass('speaker-visible');
$button.toggleClass('is-open', !isOpen);
$button.text(
isOpen
? 'See all speakers'
: 'Show fewer speakers'
);
});
});
</script>
